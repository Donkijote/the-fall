  - m_Id: 2720884405035032
    m_Localized: "\u2014 TODAY \u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035033
    m_Localized: '[HERALD] Welcome to the first season of The Fall.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035034
    m_Localized: '[PLAYER] The Baseline Bot is waiting at the table.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035035
    m_Localized: '[SCOUT] Casas are enabled by default.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035036
    m_Localized: '[GUILD] No guild is connected in this build.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035037
    m_Localized: '[GUILD] Social services remain local-only.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035038
    m_Localized: '[GUILD] Gather your table when guilds arrive.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035039
    m_Localized: '[SYSTEM] Offline first-playable ready.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035040
    m_Localized: '[SYSTEM] Target score: 24.'
    m_Metadata:
      m_Items: []
  - m_Id: 2720884405035041
    m_Localized: '[SYSTEM] Deck integrity: 40 cards.'
    m_Metadata:
      m_Items: []
