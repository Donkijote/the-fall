  m_TableData:
  - m_Id: 519036928
    m_Localized: The Fall
    m_Metadata:
      m_Items: []
  - m_Id: 328036300873728
    m_Localized: FIRST PLAYABLE
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011072
    m_Localized: A complete, deterministic table match. Configure two traditional
      rules, face one baseline bot, and race to 24.
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011073
    m_Localized: "Offline \xB7 1 player vs 1 baseline bot \xB7 First to 24"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011074
    m_Localized: Start first playable
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011075
    m_Localized: "Mouse: click \xB7 Keyboard: Tab, Enter, or Space"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011076
    m_Localized: MATCH SETUP
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011077
    m_Localized: Choose the table rules
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011078
    m_Localized: Only the two documented first-playable options can be changed. Everything
      else remains fixed.
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011079
    m_Localized: Enable Casa Grande and Casa Chica
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011080
    m_Localized: On by default. When off, those hands score as their corresponding
      Ronda.
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011081
    m_Localized: "Trivil\xEDn wins immediately"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011082
    m_Localized: "Off by default, so Trivil\xEDn awards five points. Turn this on
      for immediate victory."
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011083
    m_Localized: "Fixed match: human vs baseline bot \xB7 24-point target \xB7 complete
      1v1 rules"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011084
    m_Localized: Start match
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011085
    m_Localized: Use Tab to move, Space to toggle, and Enter to activate.
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011086
    m_Localized: Back
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011087
    m_Localized: Return Home
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011088
    m_Localized: LOADING
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011089
    m_Localized: Preparing the table
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011090
    m_Localized: "Creating a fresh deterministic match session\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011091
    m_Localized: "OFFLINE \xB7 1V1"
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011092
    m_Localized: First playable match
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011093
    m_Localized: AVAILABLE ACTIONS
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011094
    m_Localized: Choose with the mouse, or use Tab and Enter/Space.
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011095
    m_Localized: Choose a face-down dealer card
    m_Metadata:
      m_Items: []
  - m_Id: 328036347011096
