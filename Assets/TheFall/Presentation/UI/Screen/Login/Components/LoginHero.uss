.login-hero {
    width: 49%;
    max-width: 690px;
    margin-right: 7%;
}

.login-eyebrow {
    margin-bottom: 28px;
}

.login-display-title {
    color: rgb(245, 226, 176);
    font-size: 66px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.login-display-accent {
    margin-top: -4px;
    color: rgb(181, 139, 62);
}

.login-story {
    margin-top: 38px;
    flex-direction: row;
    align-items: stretch;
}

.login-story-rule {
    width: 3px;
    background-color: rgb(141, 66, 56);
}

.login-description {
    flex-grow: 1;
    margin-left: 24px;
    color: rgb(205, 187, 150);
    font-size: 22px;
    white-space: normal;
}

.login-proof {
    margin-top: 42px;
    flex-direction: row;
    align-items: center;
}

.suit-token {
    width: 52px;
    height: 52px;
    margin-right: -7px;
    border-radius: 26px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(36, 26, 20);
    border-right-color: rgb(36, 26, 20);
    border-top-color: rgb(36, 26, 20);
    border-bottom-color: rgb(36, 26, 20);
}

.suit-token-brass {
    background-color: rgb(181, 139, 62);
}

.suit-token-woad {
    background-color: rgb(70, 92, 115);
}

.suit-token-madder {
    background-color: rgb(141, 66, 56);
}

.suit-token-moss {
    background-color: rgb(107, 112, 70);
}

.suit-token-icon {
    width: 30px;
    height: 30px;
    -unity-background-image-tint-color: rgb(245, 226, 176);
}

.login-proof-copy {
    margin-left: 24px;
    color: rgb(216, 196, 147);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}
