.stage-login {
    padding: 0;
    align-items: stretch;
}

.suit-token {
    width: 52px;
    height: 52px;
    margin-right: -7px;
    border-radius: 26px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(36, 26, 20);
    border-right-color: rgb(36, 26, 20);
    border-top-color: rgb(36, 26, 20);
    border-bottom-color: rgb(36, 26, 20);
}

.suit-token-brass {
    background-color: rgb(181, 139, 62);
}

.suit-token-woad {
    background-color: rgb(70, 92, 115);
}

.suit-token-madder {
    background-color: rgb(141, 66, 56);
}

.suit-token-moss {
    background-color: rgb(107, 112, 70);
}

.suit-token-label {
    color: rgb(245, 226, 176);
    font-size: 21px;
    -unity-font-style: bold;
}

.suit-token-icon {
    width: 30px;
    height: 30px;
    -unity-background-image-tint-color: rgb(245, 226, 176);
}

/* Login-owned landscape adaptation. Keep responsive sizing out of FlowShared.uss. */
.screen-root.profile-mobile-landscape .stage {
    padding: 34px 48px;
}

.screen-root.profile-mobile-landscape .eyebrow {
    font-size: 28px;
    letter-spacing: 5px;
}

.screen-root.profile-mobile-landscape .suit-token {
    width: 64px;
    height: 64px;
    margin-right: -11px;
    border-radius: 32px;
}

.screen-root.profile-mobile-landscape .suit-token-label {
    font-size: 29px;
}

.screen-root.profile-mobile-landscape .icon-only-button {
    font-size: 0;
}

.login-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.22;
}

.login-moon {
    position: absolute;
    width: 42%;
    height: 70%;
    left: 29%;
    top: 5%;
    border-radius: 999px;
    background-color: rgb(216, 196, 147);
    opacity: 0.13;
}

.login-tower {
    position: absolute;
    bottom: -8%;
    background-color: rgb(15, 12, 10);
    border-top-left-radius: 120px;
    border-top-right-radius: 120px;
}

.login-tower-left {
    width: 17%;
    height: 61%;
    left: -3%;
}

.login-tower-center {
    width: 13%;
    height: 72%;
    left: 43.5%;
}

.login-tower-right {
    width: 20%;
    height: 57%;
    right: -4%;
}

.login-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgba(36, 26, 20, 0);
}

.login-layout {
    width: 86%;
    max-width: 1420px;
    min-height: 760px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 54px;
    padding-bottom: 54px;
}

.login-hero {
    width: 49%;
    max-width: 690px;
    margin-right: 7%;
}

.login-eyebrow {
    margin-bottom: 28px;
}

.login-display-title {
    color: rgb(245, 226, 176);
    font-size: 66px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.login-display-accent {
    margin-top: -4px;
    color: rgb(181, 139, 62);
}

.login-story {
    margin-top: 38px;
    flex-direction: row;
    align-items: stretch;
}

.login-story-rule {
    width: 3px;
    background-color: rgb(141, 66, 56);
}

.login-description {
    flex-grow: 1;
    color: rgb(205, 187, 150);
    font-size: 22px;
    white-space: normal;
    margin-left: 24px;
}

.login-proof {
    margin-top: 42px;
    flex-direction: row;
    align-items: center;
}

.login-proof-copy {
    margin-left: 24px;
    color: rgb(216, 196, 147);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.login-panel {
    width: 41%;
    min-width: 390px;
    max-width: 520px;
    padding: 38px 42px 34px 42px;
    align-items: stretch;
    border-top-color: rgba(181, 139, 62, 0.82);
    border-bottom-color: rgba(141, 66, 56, 0.72);
    background-color: rgba(43, 31, 24, 0.97);
}

.login-emblem {
    width: 70px;
    height: 70px;
    align-self: center;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(141, 66, 56);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(141, 66, 56);
    border-radius: 35px;
    background-color: rgb(36, 26, 20);
}

.login-emblem-label {
    color: rgb(245, 226, 176);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.login-panel-title {
    margin-top: 18px;
    color: rgb(245, 226, 176);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.login-panel-subtitle {
    margin-top: 5px;
    color: rgb(160, 144, 118);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.login-form {
    margin-top: 34px;
}

.login-field-label {
    margin-bottom: 7px;
    color: rgb(205, 187, 150);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.login-password-label {
    margin-top: 17px;
}

.login-field {
    height: 54px;
    color: rgb(245, 226, 176);
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 7px;
}

.login-field .unity-base-text-field__input {
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(245, 226, 176);
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 17px;
}

.login-enter-button {
    width: 100%;
    min-height: 58px;
    margin-top: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: rgb(245, 226, 176);
    background-color: rgb(141, 66, 56);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(110, 46, 40);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(110, 46, 40);
}

.login-enter-label {
    color: rgb(245, 226, 176);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.login-enter-icon {
    width: 18px;
    height: 18px;
    margin-left: 9px;
    rotate: -90deg;
    background-image: url("/Assets/TheFall/Content/UI/Icons/enter-arrow.png");
    -unity-background-image-tint-color: rgb(245, 226, 176);
}

.login-divider {
    margin-top: 28px;
    flex-direction: row;
    align-items: center;
}

.login-divider-rule {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(216, 196, 147, 0.22);
}

.login-divider-label {
    margin-left: 12px;
    margin-right: 12px;
    color: rgb(160, 144, 118);
    font-size: 11px;
    letter-spacing: 2px;
    white-space: nowrap;
}

.login-mock-note {
    margin-top: 22px;
    color: rgb(181, 165, 134);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.screen-root.profile-mobile-portrait .login-layout {
    width: 100%;
    min-height: 100%;
    padding: 84px 120px 110px 120px;
    flex-direction: column;
    align-items: stretch;
}

