    border-radius: 25px;
}

.screen-root.profile-mobile-landscape .login-google-mark {
    width: 23px;
    height: 23px;
}

.screen-root.profile-mobile-landscape .login-apple-mark {
    width: 22px;
    height: 26px;
}

.screen-root.profile-mobile-landscape .login-account-row {
    min-height: 34px;
    margin-top: 6px;
}

.screen-root.profile-mobile-landscape .login-account-prefix {
    font-size: 16px;
}

.screen-root.profile-mobile-landscape .login-lower-panel {
    margin-left: -30px;
    margin-right: -30px;
    margin-bottom: -16px;
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 8px;
}

.screen-root.profile-mobile-landscape .login-feedback {
    min-height: 14px;
    margin-top: 2px;
    font-size: 14px;
}
