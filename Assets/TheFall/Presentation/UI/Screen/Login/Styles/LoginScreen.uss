}

.login-backdrop {
    opacity: 1;
    background-image: url("/Assets/TheFall/Content/UI/LoginGatewayBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.login-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(24, 15, 12, 0.46);
}

.login-content {
    background-color: rgba(36, 26, 20, 0);
}

.login-panel {
    padding-top: 30px;
    padding-bottom: 24px;
}

.login-password-heading,
.login-social-row,
.login-account-row,
.login-input-shell {
    flex-direction: row;
    align-items: center;
}

.login-input-shell {
    height: 54px;
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 7px;
}

.login-input-icon {
    width: 42px;
    min-width: 42px;
    color: rgb(112, 136, 155);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.login-input-shell .login-field {
    flex-grow: 1;
    height: 52px;
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.login-password-heading {
    margin-top: 17px;
    justify-content: space-between;
}

.login-password-label {
    margin-top: 0;
    margin-bottom: 7px;
}

.login-link-button {
    min-height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    color: rgb(181, 139, 62);
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    font-size: 12px;
}

.login-social-row {
    height: 58px;
    min-height: 58px;
    flex-shrink: 0;
    margin-top: 20px;
    justify-content: center;
}

.login-lower-panel {
    margin-left: -42px;
    margin-right: -42px;
    margin-bottom: -24px;
    padding-left: 42px;
    padding-right: 42px;
    padding-bottom: 18px;
    background-color: rgba(36, 26, 20, 0.42);
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.login-social-button {
    width: 58px;
    min-width: 58px;
    max-width: 58px;
    height: 58px;
    min-height: 58px;
    max-height: 58px;
    flex-basis: 58px;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-color: rgba(216, 196, 147, 0.42);
    border-right-color: rgba(216, 196, 147, 0.42);
    border-top-color: rgba(216, 196, 147, 0.42);
    border-bottom-color: rgba(216, 196, 147, 0.42);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 29px;
    overflow: hidden;
}

.login-google-button {
    background-color: rgb(17, 15, 14);
}

.login-apple-button {
    background-color: rgb(17, 15, 14);
}

.login-brand-mark {
    flex-shrink: 0;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

.login-google-mark {
    width: 27px;
    height: 27px;
