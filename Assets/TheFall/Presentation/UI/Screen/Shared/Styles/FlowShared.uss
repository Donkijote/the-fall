.icon-replay {
    background-image: url("/Assets/TheFall/Content/UI/Icons/replay.png");
}

.icon-only-button {
    position: relative;
    font-size: 0;
}

.icon-label-button {
    padding-left: 42px;
}

.action-button-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    -unity-background-image-tint-color: rgb(245, 226, 176);
}
