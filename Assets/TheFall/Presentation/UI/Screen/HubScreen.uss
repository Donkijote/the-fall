}

.screen-root.profile-mobile-portrait .hub-stats {
    margin-top: 40px;
}

.screen-root.profile-mobile-portrait .hub-stat {
    min-width: 0;
    max-width: none;
    min-height: 210px;
    margin-left: 10px;
    margin-right: 10px;
    padding: 30px 20px;
    flex-direction: column;
    border-bottom-width: 9px;
}

.screen-root.profile-mobile-portrait .hub-stat-value {
    margin-left: 0;
