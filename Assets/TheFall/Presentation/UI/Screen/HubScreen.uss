}

.screen-root.profile-mobile-portrait .hub-objective-meta,
.screen-root.profile-mobile-portrait .hub-route-label,
.screen-root.profile-mobile-portrait .hub-route-copy,
.screen-root.profile-mobile-portrait .hub-prompt,
.screen-root.profile-mobile-portrait .hub-brief-key {
