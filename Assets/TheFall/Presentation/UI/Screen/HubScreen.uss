}

.screen-root.profile-mobile-portrait .hub-center-space {
    min-height: 260px;
}

.screen-root.profile-mobile-portrait .hub-watermark {
    width: 240px;
    height: 240px;
    border-radius: 120px;
}

.screen-root.profile-mobile-portrait .hub-watermark-label {
    font-size: 66px;
}

.screen-root.profile-mobile-portrait .hub-objective,
.screen-root.profile-mobile-portrait .hub-dock,
.screen-root.profile-mobile-portrait .hub-brief {
    min-height: 560px;
    margin-top: 44px;
    padding: 60px 66px;
}

.screen-root.profile-mobile-portrait .hub-objective {
    border-left-width: 10px;
}

.screen-root.profile-mobile-portrait .hub-card-title {
    margin-top: 32px;
