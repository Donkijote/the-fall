    max-height: 54px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 5px 8px;
    overflow: hidden;
    border-radius: 5px;
}

.screen-root.profile-mobile-landscape .hub-chat-date,
.screen-root.profile-mobile-landscape .hub-chat-mobile-secondary,
.screen-root.profile-mobile-landscape .hub-chat-input-label {
    display: none;
}

.screen-root.profile-mobile-landscape .hub-chat-message {
    margin-top: 2px;
    font-size: 10px;
}

.screen-root.profile-mobile-landscape .hub-chat-input-row {
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    padding: 2px 0 0 0;
}

.screen-root.profile-mobile-landscape .hub-chat-input {
    height: 44px;
    min-height: 44px;
}

.screen-root.profile-mobile-landscape .hub-chat-send {
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    margin-left: 5px;
    padding: 0;
}

.screen-root.profile-mobile-landscape .hub-send-icon {
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
}
