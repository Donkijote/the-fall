.stage-home {
    flex-direction: row;
}

.home-card {
    width: 38%;
    min-width: 330px;
    max-width: 480px;
    padding: 32px;
}

.home-card > .primary-button {
    width: 100%;
}

.screen-root.profile-mobile-portrait .stage-home {
    flex-direction: column;
}

.stage-home {
    padding: 0;
    flex-direction: column;
    align-items: stretch;
}

.hub-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgba(36, 26, 20, 0.20);
}

.hub-layout {
    width: 100%;
    height: 100%;
    min-height: 100%;
    padding: 26px 30px 30px 30px;
}

.hub-topbar,
.hub-bottombar,
.hub-stats,
.hub-route,
.hub-identity,
.hub-connection,
.hub-brief-row {
    flex-direction: row;
}

.hub-topbar {
    min-height: 86px;
    align-items: stretch;
    justify-content: space-between;
}

.hub-identity {
    width: 27%;
    min-width: 260px;
    max-width: 370px;
    padding: 12px 16px;
    align-items: center;
    border-left-width: 3px;
    border-left-color: rgb(181, 139, 62);
}

.hub-identity-seal {
    width: 58px;
    height: 58px;
    min-width: 58px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
    border-radius: 29px;
    background-color: rgb(36, 26, 20);
}

.hub-seal-label {
    color: rgb(245, 226, 176);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.hub-identity-copy {
    flex-grow: 1;
    margin-left: 14px;
}

.hub-title {
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.hub-kicker {
    margin-top: 4px;
    color: rgb(181, 139, 62);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.hub-ready-dot {
    width: 10px;
    height: 10px;
    margin-left: 10px;
    border-radius: 5px;
    background-color: rgb(107, 140, 70);
}

.hub-stats {
    flex-grow: 1;
    justify-content: center;
    margin-left: 18px;
    margin-right: 18px;
}

.hub-stat {
    width: 29%;
    min-width: 112px;
    max-width: 160px;
    margin-left: 6px;
    margin-right: 6px;
    padding: 12px 18px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom-width: 3px;
}

.hub-stat-brass {
    border-bottom-color: rgb(181, 139, 62);
}

.hub-stat-woad {
    border-bottom-color: rgb(70, 92, 115);
}

.hub-stat-madder {
    border-bottom-color: rgb(141, 66, 56);
}

.hub-stat-value {
    margin-top: 7px;
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
}

.hub-connection {
    width: 18%;
    min-width: 172px;
    max-width: 230px;
    padding: 12px 16px;
    align-items: center;
}

.hub-connection-mark {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background-color: rgba(70, 92, 115, 0.42);
}

.hub-connection-icon {
    color: rgb(107, 140, 70);
    font-size: 18px;
}

.hub-connection-title {
    color: rgb(245, 226, 176);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.hub-connection-detail {
    margin-top: 3px;
    color: rgb(160, 144, 118);
    font-size: 10px;
    letter-spacing: 1px;
}

.hub-center-space {
    flex-grow: 1;
    min-height: 170px;
    align-items: center;
    justify-content: center;
}

.hub-watermark {
    width: 138px;
    height: 138px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(216, 196, 147, 0.16);
    border-right-color: rgba(216, 196, 147, 0.16);
    border-top-color: rgba(216, 196, 147, 0.16);
    border-bottom-color: rgba(216, 196, 147, 0.16);
    border-radius: 69px;
    background-color: rgba(59, 41, 31, 0.24);
}

.hub-watermark-label {
    color: rgba(216, 196, 147, 0.18);
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.hub-bottombar {
    min-height: 190px;
    align-items: stretch;
    justify-content: space-between;
}

.hub-objective,
.hub-brief {
    width: 27%;
    min-width: 260px;
    max-width: 400px;
    padding: 22px 24px;
}

.hub-objective {
    border-left-width: 3px;
    border-left-color: rgb(141, 66, 56);
}

.hub-card-title {
    margin-top: 14px;
    color: rgb(245, 226, 176);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.hub-card-copy {
    margin-top: 8px;
    color: rgb(181, 165, 134);
    font-size: 13px;
    white-space: normal;
}

.hub-objective-progress {
    height: 6px;
    margin-top: auto;
    border-radius: 3px;
    background-color: rgba(216, 196, 147, 0.15);
}

.hub-progress-fill {
    width: 34%;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(141, 66, 56);
}

.hub-objective-meta {
    margin-top: 9px;
    color: rgb(160, 144, 118);
    font-size: 10px;
    -unity-text-align: upper-right;
    white-space: normal;
}

.hub-dock {
    width: 40%;
    min-width: 390px;
    max-width: 570px;
    margin-left: 16px;
    margin-right: 16px;
    padding: 18px 22px;
    border-top-width: 2px;
    border-top-color: rgb(181, 139, 62);
}

.hub-route-label {
    color: rgb(181, 139, 62);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.hub-route {
    flex-grow: 1;
    min-height: 100px;
    margin-top: 10px;
    align-items: stretch;
    justify-content: center;
}

.hub-route-button,
.hub-route-stop {
    width: 30%;
    min-width: 0;
    align-items: center;
    justify-content: center;
}

.hub-route-button {
    min-height: 96px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(245, 226, 176);
    background-color: rgb(141, 66, 56);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(110, 46, 40);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(110, 46, 40);
    font-size: 14px;
}

.hub-route-stop {
    opacity: 0.72;
}

.hub-route-icon {
    color: rgb(160, 144, 118);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.hub-route-copy {
    margin-top: 7px;
    color: rgb(197, 178, 142);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hub-route-divider {
    width: 1px;
    height: 64%;
    align-self: center;
    background-color: rgba(216, 196, 147, 0.18);
}

.hub-prompt {
    margin-top: 8px;
    font-size: 11px;
}

.hub-brief {
    border-right-width: 3px;
    border-right-color: rgb(70, 92, 115);
}

.hub-brief-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 8px;
    background-color: rgba(216, 196, 147, 0.22);
}

.hub-brief-row {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(216, 196, 147, 0.10);
}

.hub-brief-key {
    width: 36%;
    color: rgb(160, 144, 118);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.hub-brief-value {
    width: 62%;
    color: rgb(216, 196, 147);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.screen-root.profile-mobile-portrait .hub-layout {
    padding: 80px 110px 110px 110px;
}

.screen-root.profile-mobile-portrait .hub-topbar,
.screen-root.profile-mobile-portrait .hub-bottombar {
    flex-direction: column;
}

.screen-root.profile-mobile-portrait .hub-identity,
.screen-root.profile-mobile-portrait .hub-stats,
.screen-root.profile-mobile-portrait .hub-connection,
.screen-root.profile-mobile-portrait .hub-objective,
.screen-root.profile-mobile-portrait .hub-dock,
.screen-root.profile-mobile-portrait .hub-brief {
    width: 100%;
    min-width: 0;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
}

.screen-root.profile-mobile-portrait .hub-identity {
