.screen-root.show-login .ambient,
.screen-root.show-hub .ambient {
    display: none;
}

.login-backdrop {
    opacity: 1;
    background-image: url("/Assets/TheFall/Content/UI/LoginGatewayBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.login-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(24, 15, 12, 0.66);
}

.login-scroll {
    background-color: rgba(36, 26, 20, 0.12);
}

.login-panel {
    padding-top: 30px;
    padding-bottom: 24px;
}

.login-password-heading,
.login-social-row,
.login-account-row,
.login-input-shell {
    flex-direction: row;
    align-items: center;
}

.login-input-shell {
    height: 54px;
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 7px;
}

.login-input-icon {
    width: 42px;
    min-width: 42px;
    color: rgb(112, 136, 155);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.login-input-shell .login-field {
    flex-grow: 1;
    height: 52px;
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.login-password-heading {
    margin-top: 17px;
    justify-content: space-between;
}

.login-password-label {
    margin-top: 0;
    margin-bottom: 7px;
}

.login-link-button {
    min-height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    color: rgb(181, 139, 62);
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    font-size: 12px;
}

.login-link-button:hover,
.login-link-button:focus {
    color: rgb(245, 226, 176);
    background-color: rgba(36, 26, 20, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgb(181, 139, 62);
}

.login-social-row {
    margin-top: 20px;
    justify-content: center;
}

.login-lower-panel {
    margin-left: -42px;
    margin-right: -42px;
    margin-bottom: -24px;
    padding-left: 42px;
    padding-right: 42px;
    padding-bottom: 18px;
    background-color: rgba(36, 26, 20, 0.42);
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.login-social-button {
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(216, 196, 147);
    background-color: rgb(36, 26, 20);
    border-left-color: rgba(216, 196, 147, 0.42);
    border-right-color: rgba(216, 196, 147, 0.42);
    border-top-color: rgba(216, 196, 147, 0.42);
    border-bottom-color: rgb(141, 66, 56);
    border-bottom-width: 3px;
    border-radius: 29px;
    font-size: 21px;
}

.login-social-button:hover,
.login-social-button:focus {
    color: rgb(36, 26, 20);
    background-color: rgb(181, 139, 62);
}

.login-account-row {
    margin-top: 20px;
    justify-content: center;
}

.login-account-prefix {
    color: rgb(160, 144, 118);
    font-size: 13px;
}

.login-create-button {
    margin-left: 5px;
    color: rgb(181, 139, 62);
    -unity-font-style: bold;
}

.login-feedback {
    min-height: 18px;
    margin-top: 8px;
    color: rgb(181, 165, 134);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hub-layout {
    padding: 18px 24px 22px 24px;
    background-color: rgba(36, 26, 20, 0.82);
}

.hub-xp-row {
    margin-top: 6px;
    flex-direction: row;
    align-items: center;
}

.hub-xp-track {
    width: 78%;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(216, 196, 147, 0.16);
}

.hub-xp-fill {
    width: 72%;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(70, 92, 115);
}

.hub-xp-label {
    margin-left: 8px;
