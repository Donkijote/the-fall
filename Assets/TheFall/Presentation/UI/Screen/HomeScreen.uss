}

.hub-level-value {
    min-width: 28px;
    height: 28px;
    margin-left: 10px;
    padding-left: 7px;
    padding-right: 7px;
    color: rgb(245, 226, 176);
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.hub-resource-icon {
    margin-right: 7px;
    font-size: 19px;
    -unity-font-style: bold;
}

.hub-resource-brass {
    color: rgb(181, 139, 62);
}

.hub-resource-woad {
    color: rgb(112, 136, 155);
}

.hub-resource-madder {
    color: rgb(141, 66, 56);
}

.hub-energy-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background-color: rgba(216, 196, 147, 0.10);
}

.hub-energy-fill {
    width: 75%;
    height: 4px;
    background-color: rgb(70, 92, 115);
}

.hub-top-actions {
    width: 116px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.hub-square-button {
    width: 50px;
    min-width: 50px;
    height: 50px;
    min-height: 50px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(216, 196, 147);
    background-color: rgba(59, 41, 31, 0.96);
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 8px;
    font-size: 11px;
}

.hub-square-button:hover,
.hub-square-button:focus {
    color: rgb(245, 226, 176);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.hub-mail-dot {
    position: absolute;
    right: 53px;
    top: 10px;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(141, 66, 56);
}

.hub-center-space {
    min-height: 150px;
}

.hub-bottombar {
    min-height: 220px;
    align-items: flex-end;
}

.hub-objective {
    width: 25%;
    min-width: 270px;
    max-width: 380px;
    min-height: 220px;
}

.hub-quest-button {
    min-height: 42px;
    margin-top: 14px;
    color: rgb(245, 226, 176);
    background-color: rgb(141, 66, 56);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(110, 46, 40);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(110, 46, 40);
    font-size: 13px;
}

.hub-quest-button:hover,
.hub-quest-button:focus {
    color: rgb(36, 26, 20);
    background-color: rgb(181, 139, 62);
}

.hub-dock {
    width: 36%;
    min-width: 410px;
    max-width: 560px;
    min-height: 142px;
    padding: 12px 16px;
}

.hub-route {
    min-height: 104px;
    margin-top: 0;
}

.hub-nav-button {
    width: 24%;
    min-width: 0;
    min-height: 94px;
    padding-left: 5px;
    padding-right: 5px;
    color: rgb(181, 165, 134);
    background-color: rgba(36, 26, 20, 0.48);
    border-left-color: rgba(216, 196, 147, 0.18);
    border-right-color: rgba(216, 196, 147, 0.18);
    border-top-color: rgba(216, 196, 147, 0.18);
    border-bottom-color: rgba(216, 196, 147, 0.18);
    font-size: 12px;
    white-space: normal;
}

.hub-nav-button:hover,
.hub-nav-button:focus,
.hub-nav-selected {
    color: rgb(245, 226, 176);
    background-color: rgb(59, 41, 31);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.hub-action-status {
    min-height: 16px;
    margin-top: 5px;
    color: rgb(160, 144, 118);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hub-chat {
    width: 31%;
    min-width: 330px;
    max-width: 430px;
    min-height: 180px;
    border-right-width: 3px;
    border-right-color: rgb(70, 92, 115);
}

.hub-chat-tabs,
.hub-chat-input-row {
    flex-direction: row;
}

.hub-chat-tab {
    width: 33.33%;
    min-width: 0;
    min-height: 36px;
    padding-left: 4px;
    padding-right: 4px;
    color: rgb(160, 144, 118);
    background-color: rgb(36, 26, 20);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-color: rgba(216, 196, 147, 0.16);
    border-radius: 0;
    font-size: 11px;
}

.hub-chat-tab-active,
.hub-chat-tab:hover,
.hub-chat-tab:focus {
    color: rgb(245, 226, 176);
    border-bottom-width: 2px;
    border-bottom-color: rgb(181, 139, 62);
}

.hub-chat-feed {
    flex-grow: 1;
    min-height: 52px;
    padding: 12px 14px 8px 14px;
    background-color: rgba(36, 26, 20, 0.54);
}

.hub-chat-date {
    margin-bottom: 8px;
    color: rgb(116, 105, 88);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.hub-chat-message {
    margin-top: 6px;
    color: rgb(197, 178, 142);
    font-size: 11px;
    white-space: normal;
}

.hub-chat-user-message {
    color: rgb(112, 136, 155);
}

.hub-chat-input-label {
    margin-top: 7px;
    margin-left: 10px;
    color: rgb(116, 105, 88);
    font-size: 9px;
    letter-spacing: 1px;
}

.hub-chat-input-row {
    height: 38px;
    padding: 4px 6px 6px 8px;
}

.hub-chat-input {
    flex-grow: 1;
    height: 32px;
    color: rgb(216, 196, 147);
    background-color: rgb(36, 26, 20);
    border-left-color: rgba(216, 196, 147, 0.28);
    border-right-color: rgba(216, 196, 147, 0.28);
    border-top-color: rgba(216, 196, 147, 0.28);
    border-bottom-color: rgba(216, 196, 147, 0.28);
}

.hub-chat-input .unity-base-text-field__input {
    color: rgb(216, 196, 147);
    background-color: rgba(36, 26, 20, 0);
}

.hub-chat-send {
    width: 42px;
    min-width: 42px;
    min-height: 32px;
    margin-left: 5px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(245, 226, 176);
    background-color: rgb(70, 92, 115);
    font-size: 14px;
}

.hub-modal {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 12, 10, 0.72);
}

.hub-modal-card {
    width: 44%;
