.screen-root {
    flex-grow: 1;
    min-width: 320px;
    min-height: 480px;
    color: rgb(216, 196, 147);
    background-color: rgb(36, 26, 20);
    overflow: hidden;
}

.screen-root.show-table {
    background-color: rgba(36, 26, 20, 0.12);
}

.screen-root.show-table .ambient {
    display: none;
}

.ambient {
    position: absolute;
    width: 46%;
    height: 70%;
    border-radius: 999px;
    opacity: 0.16;
}

.ambient-left {
    left: -18%;
    top: -24%;
    background-color: rgb(181, 139, 62);
}

.ambient-right {
    right: -20%;
    bottom: -32%;
    background-color: rgb(70, 92, 115);
}

.stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 4%;
    align-items: center;
    justify-content: center;
}

.stage-login {
    padding: 0;
    align-items: stretch;
}

.login-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.22;
}

.login-moon {
    position: absolute;
    width: 42%;
    height: 70%;
    left: 29%;
    top: 5%;
    border-radius: 999px;
    background-color: rgb(216, 196, 147);
    opacity: 0.13;
}

.login-tower {
    position: absolute;
    bottom: -8%;
    background-color: rgb(15, 12, 10);
    border-top-left-radius: 120px;
    border-top-right-radius: 120px;
}

.login-tower-left {
    width: 17%;
    height: 61%;
    left: -3%;
}

.login-tower-center {
    width: 13%;
    height: 72%;
    left: 43.5%;
}

.login-tower-right {
    width: 20%;
    height: 57%;
    right: -4%;
}

.login-scroll {
    flex-grow: 1;
    background-color: rgba(36, 26, 20, 0.50);
}

.login-scroll .unity-scroll-view__content-container {
    min-height: 100%;
    justify-content: center;
}

.login-scroll .unity-scroller {
    display: none;
}

.login-layout {
    width: 86%;
    max-width: 1420px;
    min-height: 760px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 54px;
    padding-bottom: 54px;
}

.login-hero {
    width: 49%;
    max-width: 690px;
    margin-right: 7%;
}

.login-eyebrow {
    margin-bottom: 28px;
}

.login-display-title {
    color: rgb(245, 226, 176);
    font-size: 66px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.login-display-accent {
    margin-top: -4px;
    color: rgb(181, 139, 62);
}

.login-story {
    margin-top: 38px;
    flex-direction: row;
    align-items: stretch;
}

.login-story-rule {
    width: 3px;
    margin-right: 24px;
    background-color: rgb(141, 66, 56);
}

.login-description {
    flex-grow: 1;
    color: rgb(205, 187, 150);
    font-size: 20px;
    white-space: normal;
}

.login-proof {
    margin-top: 42px;
    flex-direction: row;
    align-items: center;
}

.suit-token {
    width: 44px;
    height: 44px;
    margin-right: -7px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(36, 26, 20);
    border-right-color: rgb(36, 26, 20);
    border-top-color: rgb(36, 26, 20);
    border-bottom-color: rgb(36, 26, 20);
    border-radius: 22px;
}

.suit-token-brass {
    background-color: rgb(181, 139, 62);
}

.suit-token-woad {
    background-color: rgb(70, 92, 115);
}

.suit-token-madder {
    background-color: rgb(141, 66, 56);
}

.suit-token-label {
    color: rgb(245, 226, 176);
    font-size: 21px;
    -unity-font-style: bold;
}

.login-proof-copy {
    margin-left: 24px;
    color: rgb(216, 196, 147);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.login-panel {
    width: 41%;
    min-width: 390px;
    max-width: 520px;
    padding: 38px 42px 34px 42px;
    align-items: stretch;
    border-top-color: rgba(181, 139, 62, 0.82);
    border-bottom-color: rgba(141, 66, 56, 0.72);
    background-color: rgba(43, 31, 24, 0.97);
}

.login-emblem {
    width: 70px;
    height: 70px;
    align-self: center;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(141, 66, 56);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(141, 66, 56);
    border-radius: 35px;
    background-color: rgb(36, 26, 20);
}

.login-emblem-label {
    color: rgb(245, 226, 176);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.login-panel-title {
    margin-top: 18px;
    color: rgb(245, 226, 176);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.login-panel-subtitle {
    margin-top: 5px;
    color: rgb(160, 144, 118);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.login-form {
    margin-top: 34px;
}

.login-field-label {
    margin-bottom: 7px;
    color: rgb(205, 187, 150);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.login-password-label {
    margin-top: 17px;
}

.login-field {
    height: 54px;
    color: rgb(245, 226, 176);
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 7px;
}

.login-field .unity-base-text-field__input {
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(245, 226, 176);
    background-color: rgba(36, 26, 20, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 17px;
}

.login-field:focus {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(245, 226, 176);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(245, 226, 176);
}

.login-enter-button {
    width: 100%;
    min-height: 58px;
    margin-top: 24px;
    color: rgb(245, 226, 176);
    background-color: rgb(141, 66, 56);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(110, 46, 40);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(110, 46, 40);
}

.login-enter-button:hover,
.login-enter-button:focus {
    color: rgb(36, 26, 20);
    background-color: rgb(181, 139, 62);
}

.login-divider {
    margin-top: 28px;
    flex-direction: row;
    align-items: center;
}

.login-divider-rule {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(216, 196, 147, 0.22);
}

.login-divider-label {
    margin-left: 12px;
    margin-right: 12px;
    color: rgb(160, 144, 118);
    font-size: 11px;
    letter-spacing: 2px;
    white-space: nowrap;
}

.login-mock-note {
    margin-top: 22px;
    color: rgb(181, 165, 134);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.stage-home {
    flex-direction: row;
}

.hero-mark {
    width: 50%;
    max-width: 700px;
    margin-right: 7%;
}

.eyebrow {
    color: rgb(181, 139, 62);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    white-space: normal;
}

.display-title {
    margin-top: 10px;
    color: rgb(245, 226, 176);
    font-size: 76px;
    -unity-font-style: bold;
    white-space: normal;
}

.title-rule {
    width: 84px;
    height: 4px;
    margin-top: 8px;
    margin-bottom: 24px;
    background-color: rgb(141, 66, 56);
}

.subtitle {
    max-width: 680px;
    color: rgb(205, 187, 150);
    font-size: 24px;
    white-space: normal;
}

.panel {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.30);
    border-right-color: rgba(216, 196, 147, 0.30);
    border-top-color: rgba(216, 196, 147, 0.30);
    border-bottom-color: rgba(216, 196, 147, 0.30);
    border-radius: 16px;
    background-color: rgba(59, 41, 31, 0.94);
}

.home-card {
    width: 38%;
    min-width: 330px;
    max-width: 480px;
    padding: 32px;
}

.card-label {
    color: rgb(181, 139, 62);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.mode-summary {
    margin-top: 10px;
    color: rgb(245, 226, 176);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.journey-list {
    margin-top: 22px;
    margin-bottom: 24px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(216, 196, 147, 0.20);
    border-bottom-color: rgba(216, 196, 147, 0.20);
}

.journey-step {
    min-height: 26px;
    color: rgb(197, 178, 142);
    font-size: 16px;
    white-space: normal;
}

.home-card > .primary-button {
    width: 100%;
}

Button {
    min-height: 50px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 7px;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

Button:focus,
Toggle:focus {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(245, 226, 176);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(245, 226, 176);
}

Button:disabled,
Toggle:disabled {
    opacity: 0.52;
}

.primary-button {
    color: rgb(36, 26, 20);
    background-color: rgb(216, 196, 147);
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(181, 139, 62);
}

.primary-button:hover,
.primary-button:focus {
    background-color: rgb(245, 226, 176);
}

.secondary-button,
.quiet-button {
    color: rgb(216, 196, 147);
    background-color: rgb(59, 41, 31);
    border-left-color: rgba(216, 196, 147, 0.45);
    border-right-color: rgba(216, 196, 147, 0.45);
    border-top-color: rgba(216, 196, 147, 0.45);
    border-bottom-color: rgba(216, 196, 147, 0.45);
}

.secondary-button:hover,
.secondary-button:focus,
.quiet-button:hover,
.quiet-button:focus {
    color: rgb(245, 226, 176);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.input-prompt {
    margin-top: 14px;
    color: rgb(160, 144, 118);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.setup-panel {
    width: 90%;
    max-width: 1120px;
    height: 92%;
    max-height: 760px;
    padding: 30px;
}

.setup-scroll {
    flex-grow: 1;
    min-height: 0;
}

.setup-scroll .unity-scroll-view__content-container {
    padding-right: 8px;
}

.section-title {
    margin-top: 6px;
    color: rgb(245, 226, 176);
    font-size: 38px;
    -unity-font-style: bold;
    white-space: normal;
}

.compact-title {
    font-size: 27px;
}

.body-copy {
    margin-top: 10px;
    margin-bottom: 18px;
    color: rgb(197, 178, 142);
    font-size: 17px;
    white-space: normal;
}

.default-note {
    margin-bottom: 10px;
    color: rgb(181, 139, 62);
    font-size: 14px;
    white-space: normal;
}

.setup-options {
    flex-direction: row;
    justify-content: space-between;
}

.option-card {
    width: 49%;
    min-height: 210px;
    margin-top: 12px;
    padding: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.24);
    border-right-color: rgba(216, 196, 147, 0.24);
    border-top-color: rgba(216, 196, 147, 0.24);
    border-bottom-color: rgba(216, 196, 147, 0.24);
    border-radius: 10px;
    background-color: rgba(36, 26, 20, 0.70);
}

.default-badge {
    align-self: flex-start;
    min-width: 156px;
    margin-bottom: 8px;
    padding: 4px 8px;
    color: rgb(36, 26, 20);
    background-color: rgb(181, 139, 62);
    border-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.rule-toggle {
    min-height: 44px;
    color: rgb(236, 215, 169);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.option-description {
    margin-top: 8px;
    color: rgb(181, 165, 134);
    font-size: 14px;
    white-space: normal;
}

.option-state {
    margin-top: auto;
    padding-top: 12px;
    color: rgb(216, 196, 147);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.fixed-card {
    margin-top: 16px;
    padding: 14px 16px;
    flex-direction: row;
    align-items: center;
    border-radius: 8px;
    background-color: rgba(70, 92, 115, 0.28);
}

.fixed-card > .card-label {
    min-width: 132px;
    margin-right: 16px;
}

.fixed-summary {
    flex-grow: 1;
    color: rgb(216, 196, 147);
    font-size: 14px;
    white-space: normal;
}

.setup-footer {
    margin-top: 18px;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: rgba(216, 196, 147, 0.22);
}

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.button-row > Button {
    min-width: 170px;
    margin-left: 12px;
}

.loading-panel {
    width: 70%;
    max-width: 620px;
    padding: 42px;
    align-items: center;
}

.loading-session {
    margin-top: 6px;
    padding: 10px 16px;
    color: rgb(245, 226, 176);
    background-color: rgba(70, 92, 115, 0.30);
    border-radius: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.loading-status {
    margin-top: 12px;
    color: rgb(160, 144, 118);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.loading-cancel {
    min-width: 240px;
    margin-top: 18px;
}

.loading-glyph {
    width: 58px;
    height: 58px;
    margin-top: 26px;
    margin-bottom: 18px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(70, 92, 115);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(70, 92, 115);
    border-radius: 29px;
}

.centered {
    -unity-text-align: middle-center;
}

.stage-match {
    padding: 24px;
    align-items: stretch;
}

.match-shell {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: none;
}

.presentation-toggle {
    min-height: 38px;
    margin-right: 12px;
    color: rgb(216, 196, 147);
    font-size: 13px;
    white-space: normal;
}

.presentation-skip {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    margin-top: 18px;
}

.quiet-button {
    min-width: 150px;
}

.match-status {
    position: absolute;
    left: 0;
    top: 50%;
    width: 270px;
    min-width: 270px;
    max-height: 430px;
    margin-top: -190px;
    padding: 20px;
    background-color: rgba(36, 26, 20, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(181, 139, 62);
}

.match-table-space {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
}

.match-score-hud {
    position: absolute;
    left: 50%;
    top: 0;
    width: 430px;
    min-width: 430px;
    margin-left: -215px;
    padding: 9px 20px;
    background-color: rgba(36, 26, 20, 0.92);
    border-bottom-width: 3px;
    border-bottom-color: rgb(181, 139, 62);
}

.match-home-floating {
    position: absolute;
    right: 0;
    top: 0;
    min-width: 170px;
    min-height: 48px;
    background-color: rgba(36, 26, 20, 0.88);
}

.status-title {
    color: rgb(181, 139, 62);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.match-status-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 14px;
    background-color: rgba(216, 196, 147, 0.24);
}

.match-primary-status {
    color: rgb(245, 226, 176);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.score-line {
    color: rgb(245, 226, 176);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.status-line {
    margin-top: 10px;
    color: rgb(197, 178, 142);
    font-size: 16px;
    white-space: normal;
}

.event-line {
    margin-top: 14px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(216, 196, 147, 0.24);
    color: rgb(216, 196, 147);
    -unity-font-style: bold;
}

.interaction-feedback {
    min-height: 0;
    margin-top: 12px;
    color: rgb(174, 162, 139);
    font-size: 12px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.match-context-controls {
    position: absolute;
    left: 50%;
    bottom: 13%;
    margin-left: 86px;
    flex-direction: row;
    align-items: flex-end;
}

.player-context {
    display: none;
    width: 64px;
    margin-left: 10px;
    align-items: center;
}

.context-icon {
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    padding-left: 0;
    padding-right: 0;
    border-radius: 29px;
    color: rgb(36, 26, 20);
    background-color: rgb(216, 196, 147);
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(181, 139, 62);
    font-size: 17px;
    -unity-font-style: bold;
}

.context-icon:hover,
.context-icon:focus {
    background-color: rgb(245, 226, 176);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.dealer-icon {
    background-color: rgb(181, 139, 62);
}

.canto-icon {
    color: rgb(245, 226, 176);
    background-color: rgb(70, 92, 115);
}

.context-menu {
    display: none;
    position: absolute;
    width: 410px;
    max-height: 330px;
    left: 0;
    bottom: 68px;
    padding: 16px;
}

.context-title {
    margin-bottom: 10px;
    color: rgb(245, 226, 176);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.context-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.context-action-button {
    width: 48%;
    min-height: 46px;
    margin-right: 2%;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(236, 215, 169);
    background-color: rgb(70, 92, 115);
    border-left-color: rgb(112, 136, 155);
    border-right-color: rgb(50, 68, 82);
    border-top-color: rgb(112, 136, 155);
    border-bottom-color: rgb(50, 68, 82);
    font-size: 14px;
}

.context-action-button:hover,
.context-action-button:focus {
    color: rgb(245, 226, 176);
    background-color: rgb(84, 109, 132);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.result-panel {
    width: 76%;
    max-width: 900px;
    max-height: 92%;
    padding: 34px 42px;
    align-items: center;
}

#result-eyebrow {
    min-width: 120px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.result-seal {
    width: 78%;
    min-height: 150px;
    margin-top: 22px;
    margin-bottom: 16px;
    padding: 24px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
    border-radius: 14px;
    background-color: rgba(36, 26, 20, 0.72);
}

.result-winner-label {
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.result-outcome {
    color: rgb(245, 226, 176);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.result-score {
    color: rgb(197, 178, 142);
    font-size: 19px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.result-rules {
    margin-top: 8px;
    color: rgb(181, 165, 134);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.result-next {
    margin-top: 22px;
    color: rgb(245, 226, 176);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.result-panel > .button-row {
    width: 100%;
    justify-content: center;
    margin-top: 12px;
}

.result-panel > .button-row > Button {
    width: 42%;
    max-width: 260px;
}

.semantic-legal {
    border-left-color: rgb(107, 140, 70);
    border-right-color: rgb(107, 140, 70);
    border-top-color: rgb(107, 140, 70);
    border-bottom-color: rgb(107, 140, 70);
}

.semantic-selected {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
}

.semantic-confirmed {
    border-left-color: rgb(112, 136, 155);
    border-right-color: rgb(112, 136, 155);
    border-top-color: rgb(112, 136, 155);
    border-bottom-color: rgb(112, 136, 155);
}

.semantic-rejected {
    border-left-color: rgb(141, 66, 56);
    border-right-color: rgb(141, 66, 56);
    border-top-color: rgb(141, 66, 56);
    border-bottom-color: rgb(141, 66, 56);
}

.semantic-blocked {
    border-left-color: rgb(160, 144, 118);
    border-right-color: rgb(160, 144, 118);
    border-top-color: rgb(160, 144, 118);
    border-bottom-color: rgb(160, 144, 118);
    opacity: 0.72;
}

