/* Desktop is the unqualified component style. */
.hub-identity {
    width: 27%;
    min-width: 260px;
    max-width: 370px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    border-left-width: 3px;
    border-left-color: rgb(181, 139, 62);
}

.hub-identity-seal {
    width: 58px;
    height: 58px;
    min-width: 58px;
    align-items: center;
    justify-content: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
    border-radius: 29px;
    background-color: rgb(36, 26, 20);
}

.hub-seal-icon {
    width: 38px;
    height: 38px;
    -unity-background-image-tint-color: rgb(181, 139, 62);
}

.hub-identity-copy {
    flex-grow: 1;
    margin-left: 14px;
}

.hub-title {
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.hub-kicker {
    margin-top: 4px;
    color: rgb(181, 139, 62);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.hub-xp-row {
    margin-top: 6px;
    flex-direction: row;
    align-items: center;
}

.hub-xp-track {
    width: 78%;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(216, 196, 147, 0.16);
}

.hub-xp-fill {
    width: 72%;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(70, 92, 115);
}

.hub-xp-label {
    margin-left: 8px;
    color: rgb(160, 144, 118);
    font-size: 9px;
}

.hub-level-value {
    min-width: 28px;
    height: 28px;
    margin-left: 10px;
    padding-left: 7px;
    padding-right: 7px;
    color: rgb(245, 226, 176);
    background-color: rgb(36, 26, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(181, 139, 62);
    border-radius: 5px;
    -unity-text-align: middle-center;
}

