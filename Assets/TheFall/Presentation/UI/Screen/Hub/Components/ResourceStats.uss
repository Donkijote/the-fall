/* Desktop is the unqualified component style. */
.hub-stats {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    margin-left: 18px;
    margin-right: 18px;
}

.hub-stat {
    width: 29%;
    min-width: 112px;
    max-width: 160px;
    margin-left: 6px;
    margin-right: 6px;
    padding: 12px 18px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom-width: 3px;
}

.hub-stat-brass { border-bottom-color: rgb(181, 139, 62); }
.hub-stat-woad { border-bottom-color: rgb(70, 92, 115); }
.hub-stat-madder { border-bottom-color: rgb(141, 66, 56); }

.hub-stat-value {
    margin-top: 7px;
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
}

.hub-resource-icon {
    width: 28px;
    height: 28px;
}

.hub-resource-brass { -unity-background-image-tint-color: rgb(181, 139, 62); }
.hub-resource-woad { -unity-background-image-tint-color: rgb(112, 136, 155); }
.hub-resource-madder { -unity-background-image-tint-color: rgb(141, 66, 56); }

/* Phone Landscape */
.screen-root.profile-phone-landscape .hub-stat {
    max-height: 100px;
}

/* Tablet Landscape overrides belong below. */
