<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/SettingsModal.uss"/>
    <ui:VisualElement class="hub-modal-card panel">
        <ui:Label name="hub-modal-eyebrow" class="card-label">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.modal.eyebrow"/>
            </Bindings>
        </ui:Label>
        <ui:Label name="hub-modal-title" text="Settings" class="section-title"/>
        <ui:Label name="hub-modal-description" text="Adjust the rules, sound, and motion used for your next quest." class="body-copy"/>
        <ui:VisualElement name="hub-settings-content" class="hub-settings-content">
            <ui:VisualElement class="hub-settings-group hub-settings-rules">
                <ui:VisualElement class="hub-settings-title-row">
                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-quest"/>
                    <ui:Label name="home-settings-rules-label" class="hub-settings-heading">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.rules-label"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Label name="home-settings-rules-copy" class="hub-settings-intro">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.rules-copy"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="hub-settings-grid">
                    <ui:VisualElement class="hub-setting-card">
                        <ui:Toggle name="home-settings-casas-toggle" value="true" class="rule-toggle hub-setting-toggle">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.casas"/>
                            </Bindings>
                        </ui:Toggle>
                        <ui:Label name="home-settings-casas-description" class="hub-setting-description">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.casas-description"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement class="hub-setting-card">
                        <ui:Toggle name="home-settings-trivilin-toggle" class="rule-toggle hub-setting-toggle">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.trivilin"/>
                            </Bindings>
                        </ui:Toggle>
                        <ui:Label name="home-settings-trivilin-description" class="hub-setting-description">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.trivilin-description"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hub-settings-group hub-settings-audio">
                <ui:VisualElement class="hub-settings-title-row">
                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-audio"/>
                    <ui:Label name="home-settings-audio-label" class="hub-settings-heading">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.audio-label"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Label name="home-settings-audio-copy" class="hub-settings-intro">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.audio-copy"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="hub-settings-compact-grid">
                    <ui:Toggle name="home-settings-audio-master-toggle" value="true" class="presentation-toggle hub-setting-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.master"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle name="home-settings-audio-effects-toggle" value="true" class="presentation-toggle hub-setting-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.effects"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle name="home-settings-audio-music-toggle" class="presentation-toggle hub-setting-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.music"/>
                        </Bindings>
                    </ui:Toggle>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hub-settings-group hub-settings-motion">
                <ui:VisualElement class="hub-settings-title-row">
                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-skip"/>
                    <ui:Label name="home-settings-motion-label" class="hub-settings-heading">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.motion-label"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Label name="home-settings-motion-copy" class="hub-settings-intro">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.motion-copy"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="hub-settings-compact-grid">
                    <ui:Toggle name="home-settings-animation-fast-toggle" class="presentation-toggle hub-setting-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.animation.fast-forward"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle name="home-settings-animation-reduced-toggle" class="presentation-toggle hub-setting-toggle">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.animation.reduced-motion"/>
                        </Bindings>
                    </ui:Toggle>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Game-icons.net · CC BY 3.0 · Lorc, Delapouite &amp; Faithtoken" class="hub-icon-credit"/>
        </ui:VisualElement>
        <ui:Button name="hub-modal-close-button" class="secondary-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.common.close"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
