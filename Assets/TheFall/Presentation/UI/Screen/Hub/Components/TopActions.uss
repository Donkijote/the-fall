/* Desktop is the unqualified component style. */
.hub-top-actions {
    width: 116px;
    flex-direction: row;
    align-self: flex-start;
    align-items: center;
    justify-content: flex-end;
}

.hub-square-button {
    width: 50px;
    min-width: 50px;
    height: 50px;
    min-height: 50px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(216, 196, 147);
    background-color: rgba(59, 41, 31, 0.96);
    border-left-color: rgba(216, 196, 147, 0.35);
    border-right-color: rgba(216, 196, 147, 0.35);
    border-top-color: rgba(216, 196, 147, 0.35);
    border-bottom-color: rgba(216, 196, 147, 0.35);
    border-radius: 8px;
    font-size: 11px;
}

.hub-square-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 27px;
    height: 27px;
    margin-left: -14px;
    margin-top: -14px;
    -unity-background-image-tint-color: rgb(216, 196, 147);
}

.hub-mail-dot {
    position: absolute;
    right: -4px;
    top: -5px;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(141, 66, 56);
}

