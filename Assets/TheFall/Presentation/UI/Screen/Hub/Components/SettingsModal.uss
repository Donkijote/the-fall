/* Desktop is the unqualified component style. */
.presentation-toggle {
    min-height: 64px;
    margin-right: 12px;
    color: rgb(216, 196, 147);
    font-size: 13px;
    white-space: normal;
}

.hub-modal {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 12, 10, 0.72);
}

.hub-modal-card {
    width: 44%;
    min-width: 420px;
    max-width: 640px;
    padding: 34px;
    border-top-width: 3px;
    border-top-color: rgb(181, 139, 62);
}

.hub-modal-card > Button {
    align-self: flex-end;
    min-width: 150px;
}

.hub-settings-content {
    display: none;
    position: relative;
    min-height: 0;
    margin-top: 22px;
    margin-bottom: 24px;
    padding-bottom: 22px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    overflow: hidden;
}

.hub-settings-group {
    width: 32%;
    min-width: 0;
    margin-right: 1.33%;
    padding: 14px;
    border-top-width: 1px;
    border-top-color: rgba(216, 196, 147, 0.25);
}

.hub-settings-rules { width: 36%; }
.hub-settings-audio,
.hub-settings-motion { width: 30%; }

.hub-settings-title-row {
    flex-direction: row;
    align-items: center;
}

.hub-settings-heading {
    color: rgb(245, 226, 176);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.hub-settings-intro {
    margin-top: 7px;
    margin-bottom: 14px;
    color: rgb(174, 162, 139);
    font-size: 12px;
    white-space: normal;
}

.hub-settings-grid,
.hub-settings-compact-grid {
    flex-direction: column;
    flex-wrap: nowrap;
}

.hub-setting-card {
    width: 100%;
    min-height: 0;
    margin-bottom: 8px;
    padding: 16px;
    background-color: rgba(41, 32, 25, 0.9);
    border-left-width: 2px;
    border-left-color: rgb(181, 139, 62);
    border-right-width: 1px;
    border-right-color: rgba(216, 196, 147, 0.18);
    border-top-width: 1px;
    border-top-color: rgba(216, 196, 147, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(216, 196, 147, 0.18);
}

.hub-setting-toggle {
    min-height: 64px;
    flex-shrink: 0;
    margin-right: 14px;
    margin-bottom: 8px;
    color: rgb(231, 218, 184);
    font-size: 13px;
    white-space: normal;
}

.hub-setting-toggle .unity-toggle__label { white-space: normal; }

.hub-settings-compact-grid .presentation-toggle.hub-setting-toggle {
    width: 100%;
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    flex-basis: 64px;
    flex-shrink: 0;
    margin-right: 0;
    margin-bottom: 8px;
    padding: 11px 12px;
    background-color: rgba(41, 32, 25, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(216, 196, 147, 0.22);
    border-right-color: rgba(216, 196, 147, 0.22);
    border-top-color: rgba(216, 196, 147, 0.22);
    border-bottom-color: rgba(216, 196, 147, 0.22);
}

.hub-setting-description {
    color: rgb(157, 146, 126);
    font-size: 11px;
    white-space: normal;
}

.hub-settings-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    -unity-background-image-tint-color: rgb(181, 139, 62);
}

.hub-icon-credit {
    position: absolute;
    left: 14px;
    bottom: 0;
    margin-top: 4px;
    color: rgb(116, 105, 88);
    font-size: 10px;
    white-space: normal;
}

.hub-modal.hub-modal-settings .hub-modal-card {
    width: 88%;
    max-width: 1420px;
    max-height: 92%;
    padding: 26px 30px;
}

