/* Desktop is the unqualified component style. */
.hub-objective {
    width: 25%;
    min-width: 270px;
    max-width: 380px;
    min-height: 220px;
    padding: 22px 24px;
    border-left-width: 3px;
    border-left-color: rgb(141, 66, 56);
}

.hub-card-title {
    margin-top: 14px;
    color: rgb(245, 226, 176);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.hub-card-copy {
    margin-top: 8px;
    color: rgb(181, 165, 134);
    font-size: 13px;
    white-space: normal;
}

.hub-objective-progress {
    height: 6px;
    margin-top: auto;
    border-radius: 3px;
    background-color: rgba(216, 196, 147, 0.15);
}

.hub-progress-fill {
    width: 34%;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(141, 66, 56);
}

.hub-objective-meta {
    margin-top: 9px;
    color: rgb(160, 144, 118);
    font-size: 10px;
    -unity-text-align: upper-right;
    white-space: normal;
}

.hub-brief-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 8px;
    background-color: rgba(216, 196, 147, 0.22);
}

.hub-quest-button {
    min-height: 42px;
    margin-top: 14px;
    color: rgb(245, 226, 176);
    background-color: rgb(141, 66, 56);
    border-left-color: rgb(181, 139, 62);
    border-right-color: rgb(110, 46, 40);
    border-top-color: rgb(181, 139, 62);
    border-bottom-color: rgb(110, 46, 40);
    font-size: 13px;
}

