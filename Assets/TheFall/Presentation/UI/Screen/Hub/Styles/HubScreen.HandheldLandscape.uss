/*
 * Shared Phone Landscape and Tablet Landscape overrides.
 * This file loads after HubScreen.Base.uss. Later equal-specificity rules in this file win.
 */

/* Initial handheld scale and spacing overrides. */
.screen-root.profile-mobile-landscape .hub-layout {
    padding: 30px 46px 36px 46px;
}

.screen-root.profile-mobile-landscape .hub-topbar {
    min-height: 142px;
}

.screen-root.profile-mobile-landscape .hub-identity {
    min-width: 390px;
    max-width: 500px;
    padding: 20px 24px;
}

.screen-root.profile-mobile-landscape .hub-identity-seal {
    width: 92px;
    height: 92px;
    min-width: 92px;
    border-radius: 46px;
}

.screen-root.profile-mobile-landscape .hub-seal-label {
    font-size: 28px;
}

.screen-root.profile-mobile-landscape .hub-title {
    font-size: 39px;
}

.screen-root.profile-mobile-landscape .hub-kicker,
.screen-root.profile-mobile-landscape .hub-connection-detail,
.screen-root.profile-mobile-landscape .hub-objective-meta,
.screen-root.profile-mobile-landscape .hub-route-label,
.screen-root.profile-mobile-landscape .hub-route-copy,
.screen-root.profile-mobile-landscape .hub-prompt,
.screen-root.profile-mobile-landscape .hub-brief-key {
    font-size: 19px;
}

.screen-root.profile-mobile-landscape .hub-stat {
    min-width: 174px;
    max-width: 220px;
    padding: 20px;
}

.screen-root.profile-mobile-landscape .hub-stat-value {
    font-size: 38px;
}

.screen-root.profile-mobile-landscape .hub-connection {
    min-width: 260px;
    max-width: 320px;
}

.screen-root.profile-mobile-landscape .hub-connection-title,
.screen-root.profile-mobile-landscape .hub-card-copy,
.screen-root.profile-mobile-landscape .hub-brief-value {
    font-size: 24px;
}

.screen-root.profile-mobile-landscape .hub-center-space {
    min-height: 120px;
}

.screen-root.profile-mobile-landscape .hub-bottombar {
    min-height: 330px;
}

.screen-root.profile-mobile-landscape .hub-objective,
.screen-root.profile-mobile-landscape .hub-brief {
    min-width: 400px;
    max-width: 540px;
    padding: 34px;
}

.screen-root.profile-mobile-landscape .hub-card-title {
    font-size: 34px;
}

.screen-root.profile-mobile-landscape .hub-dock {
    min-width: 610px;
    max-width: 760px;
    padding: 28px 34px;
}

.screen-root.profile-mobile-landscape .hub-route {
    min-height: 160px;
}

.screen-root.profile-mobile-landscape .hub-route-button {
    min-height: 150px;
    font-size: 26px;
}

.screen-root.profile-mobile-landscape .hub-route-icon {
    font-size: 40px;
}

/* Handheld actions, chat, settings, and icon refinements. */
.screen-root.profile-mobile-landscape .hub-top-actions {
    width: 190px;
}

.screen-root.profile-mobile-landscape .hub-square-button {
    width: 82px;
    min-width: 82px;
    height: 82px;
    min-height: 82px;
    font-size: 18px;
}

.screen-root.profile-mobile-landscape .hub-bottombar {
    min-height: 430px;
}

.screen-root.profile-mobile-landscape .hub-objective {
    width: 25%;
    min-width: 420px;
}

.screen-root.profile-mobile-landscape .hub-dock {
    width: 34%;
    min-width: 660px;
}

.screen-root.profile-mobile-landscape .hub-chat {
    width: 32%;
    min-width: 530px;
    min-height: 430px;
}

.screen-root.profile-mobile-landscape .hub-nav-button,
.screen-root.profile-mobile-landscape .hub-chat-tab {
    min-height: 145px;
    font-size: 24px;
}

.screen-root.profile-mobile-landscape .hub-chat-message {
    font-size: 20px;
}

.screen-root.profile-mobile-landscape .hub-modal-card {
    width: 62%;
    max-width: 1000px;
    max-height: 88%;
}

.screen-root.profile-mobile-landscape .hub-modal.hub-modal-settings .hub-modal-card {
    width: 68%;
    max-width: 1100px;
}

.screen-root.profile-mobile-landscape .hub-settings-content {
    max-height: 520px;
}

.screen-root.profile-mobile-landscape .hub-setting-toggle {
    min-height: 64px;
    font-size: 18px;
}

.screen-root.profile-mobile-landscape .hub-square-icon {
    width: 42px;
    height: 42px;
    margin-left: -21px;
    margin-top: -21px;
}

.screen-root.profile-mobile-landscape .hub-nav-button {
    padding-top: 70px;
}

.screen-root.profile-mobile-landscape .hub-nav-icon {
    top: 16px;
    width: 46px;
    height: 46px;
    margin-left: -23px;
}

.screen-root.profile-mobile-landscape .hub-settings-icon {
    width: 30px;
    height: 30px;
    margin-right: 14px;
}

/* Single-viewport handheld guardrails. */
.screen-root.profile-mobile-landscape .hub-layout {
    min-height: 0;
    padding: 20px 34px 24px 34px;
}

.screen-root.profile-mobile-landscape .hub-topbar {
    min-height: 112px;
}

.screen-root.profile-mobile-landscape .hub-center-space {
    min-height: 32px;
}

.screen-root.profile-mobile-landscape .hub-bottombar {
    min-height: 390px;
}

.screen-root.profile-mobile-landscape .hub-objective {
    min-width: 390px;
}

.screen-root.profile-mobile-landscape .hub-dock {
    min-width: 620px;
}

.screen-root.profile-mobile-landscape .hub-chat {
    min-width: 500px;
    min-height: 390px;
}

.screen-root.profile-mobile-landscape .hub-nav-button,
.screen-root.profile-mobile-landscape .hub-chat-tab {
    min-height: 118px;
}

.screen-root.profile-mobile-landscape .hub-modal-card,
.screen-root.profile-mobile-landscape .hub-modal.hub-modal-settings .hub-modal-card {
    width: 94%;
    max-width: none;
    max-height: 94%;
    padding: 20px 24px;
}

.screen-root.profile-mobile-landscape .hub-settings-content {
    flex-grow: 1;
    max-height: none;
    margin-top: 12px;
    margin-bottom: 12px;
    padding-bottom: 18px;
}

.screen-root.profile-mobile-landscape .hub-settings-group {
    margin-bottom: 0;
    padding: 10px 12px;
}

.screen-root.profile-mobile-landscape .hub-settings-heading {
    font-size: 20px;
}

.screen-root.profile-mobile-landscape .hub-settings-intro,
.screen-root.profile-mobile-landscape .hub-setting-description {
    font-size: 16px;
}

.screen-root.profile-mobile-landscape .hub-setting-toggle,
.screen-root.profile-mobile-landscape .hub-settings-compact-grid .hub-setting-toggle {
    min-height: 68px;
    margin-bottom: 6px;
    padding: 8px 10px;
    font-size: 20px;
}

.screen-root.profile-mobile-landscape .hub-modal-card > Button {
    min-height: 82px;
}

/*
 * Phone and tablet landscape Hub composition.
 *
 * The safe-area-aware stage owns the hardware insets. These small internal gutters pin identity
 * and global actions to that safe frame, while the objective and navigation dock share the bottom
 * edge. Chat is deliberately removed from the bottom-row flex calculation and floats above the
 * navigation dock, leaving every persistent action visible and touchable.
 */
.screen-root.profile-mobile-landscape .hub-layout {
    position: relative;
    min-height: 0;
    padding: 10px 12px 12px 12px;
}

.screen-root.profile-mobile-landscape .hub-topbar {
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    align-items: stretch;
}

.screen-root.profile-mobile-landscape .hub-identity {
    width: 285px;
    min-width: 285px;
    max-width: 300px;
    padding: 8px 10px;
}

.screen-root.profile-mobile-landscape .hub-identity-seal {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 26px;
}

.screen-root.profile-mobile-landscape .hub-seal-icon {
    width: 30px;
    height: 30px;
}

.screen-root.profile-mobile-landscape .hub-identity-copy {
    margin-left: 9px;
}

.screen-root.profile-mobile-landscape .hub-title {
    font-size: 17px;
    white-space: nowrap;
}

.screen-root.profile-mobile-landscape .hub-kicker {
    margin-top: 2px;
    font-size: 9px;
    white-space: nowrap;
}

.screen-root.profile-mobile-landscape .hub-xp-row {
    margin-top: 3px;
}

.screen-root.profile-mobile-landscape .hub-level-value {
    min-width: 24px;
    height: 24px;
    margin-left: 6px;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 10px;
}

.screen-root.profile-mobile-landscape .hub-xp-label {
    margin-left: 5px;
    font-size: 8px;
}

.screen-root.profile-mobile-landscape .hub-stats {
    margin-left: 8px;
    margin-right: 8px;
}

.screen-root.profile-mobile-landscape .hub-stat {
    width: 31%;
    min-width: 70px;
    max-width: 88px;
    margin-left: 3px;
    margin-right: 3px;
    padding: 6px 8px;
}

.screen-root.profile-mobile-landscape .hub-resource-icon {
    width: 22px;
    height: 22px;
}

.screen-root.profile-mobile-landscape .hub-stat-value {
    margin-top: 4px;
    font-size: 17px;
}

.screen-root.profile-mobile-landscape .hub-top-actions {
    width: 106px;
}

.screen-root.profile-mobile-landscape .hub-square-button {
    width: 50px;
    min-width: 50px;
    height: 50px;
    min-height: 50px;
    margin-left: 6px;
    padding: 0;
}

.screen-root.profile-mobile-landscape .hub-square-icon {
    width: 27px;
    height: 27px;
    margin-left: -14px;
    margin-top: -14px;
}

.screen-root.profile-mobile-landscape .hub-center-space {
    flex-grow: 1;
    min-height: 0;
}

.screen-root.profile-mobile-landscape .hub-bottombar {
    position: relative;
    height: 148px;
    min-height: 148px;
    max-height: 148px;
    flex-shrink: 0;
    align-items: flex-end;
    justify-content: space-between;
    overflow: visible;
}

.screen-root.profile-mobile-landscape .hub-objective {
    width: 240px;
    min-width: 240px;
    max-width: 260px;
    height: 148px;
    min-height: 148px;
    max-height: 148px;
    padding: 9px 12px 10px 12px;
}

.screen-root.profile-mobile-landscape .hub-objective .card-label {
    font-size: 11px;
}

.screen-root.profile-mobile-landscape .hub-objective .hub-brief-rule {
    margin-top: 4px;
    margin-bottom: 3px;
}

.screen-root.profile-mobile-landscape .hub-card-title {
    margin-top: 1px;
    font-size: 17px;
}

.screen-root.profile-mobile-landscape .hub-card-copy,
.screen-root.profile-mobile-landscape .hub-objective-meta {
    display: none;
}

.screen-root.profile-mobile-landscape .hub-objective-progress {
    height: 5px;
    margin-top: 7px;
}

.screen-root.profile-mobile-landscape .hub-progress-fill {
    height: 5px;
}

.screen-root.profile-mobile-landscape .hub-quest-button {
    min-height: 46px;
    margin-top: 7px;
    padding-left: 34px;
    padding-right: 10px;
    font-size: 12px;
}

.screen-root.profile-mobile-landscape .hub-quest-button .action-button-icon {
    left: 10px;
    width: 18px;
    height: 18px;
    margin-top: -9px;
}

.screen-root.profile-mobile-landscape .hub-dock {
    width: 430px;
    min-width: 0;
    max-width: 430px;
    height: 112px;
    min-height: 112px;
    max-height: 112px;
    margin-left: 12px;
    margin-right: 0;
    padding: 7px 10px;
}

.screen-root.profile-mobile-landscape .hub-route {
    min-height: 80px;
    max-height: 80px;
    margin-top: 0;
}

.screen-root.profile-mobile-landscape .hub-nav-button {
    min-height: 80px;
    padding: 43px 4px 3px 4px;
    font-size: 11px;
}

.screen-root.profile-mobile-landscape .hub-nav-icon {
    top: 9px;
    width: 29px;
    height: 29px;
    margin-left: -15px;
}

.screen-root.profile-mobile-landscape .hub-action-status {
    min-height: 13px;
    margin-top: 2px;
    font-size: 9px;
}

.screen-root.profile-mobile-landscape .hub-chat {
    position: absolute;
    right: 0;
    bottom: 124px;
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    height: 166px;
    min-height: 166px;
    max-height: 166px;
    padding: 6px;
    overflow: hidden;
    border-radius: 12px;
}

.screen-root.profile-mobile-landscape .hub-chat-tabs {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin-bottom: 4px;
    border-radius: 7px;
}

.screen-root.profile-mobile-landscape .hub-chat-tab {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    padding-left: 0;
    padding-right: 0;
    font-size: 11px;
}

.screen-root.profile-mobile-landscape .hub-chat-feed {
    height: 54px;
    min-height: 54px;
    max-height: 54px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 5px 8px;
    overflow: hidden;
    border-radius: 5px;
}

.screen-root.profile-mobile-landscape .hub-chat-date,
.screen-root.profile-mobile-landscape .hub-chat-mobile-secondary,
.screen-root.profile-mobile-landscape .hub-chat-input-label {
    display: none;
}

.screen-root.profile-mobile-landscape .hub-chat-message {
    margin-top: 2px;
    font-size: 10px;
}

.screen-root.profile-mobile-landscape .hub-chat-input-row {
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    padding: 2px 0 0 0;
}

.screen-root.profile-mobile-landscape .hub-chat-input {
    height: 44px;
    min-height: 44px;
}

.screen-root.profile-mobile-landscape .hub-chat-send {
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    margin-left: 5px;
    padding: 0;
}

.screen-root.profile-mobile-landscape .hub-send-icon {
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
}
