/* Desktop is the unqualified Hub shell. Components own all of their internal styles. */
.stage-home {
    padding: 0;
    flex-direction: column;
    align-items: stretch;
}

.hub-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.hub-layout {
    width: 100%;
    height: 100%;
    min-height: 100%;
    padding: 24px;
}

.hub-topbar,
.hub-bottombar {
    flex-direction: row;
    justify-content: space-between;
}

.hub-topbar {
    min-height: 86px;
    align-items: stretch;
}

.hub-center-space {
    flex-grow: 1;
    min-height: 150px;
}

.hub-bottombar {
    min-height: 220px;
    align-items: flex-end;
}

/* Phone Landscape overrides belong here when the Hub shell itself differs. */

/* Tablet Landscape overrides belong here when the Hub shell itself differs. */
