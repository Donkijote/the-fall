<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Shared/Styles/FlowShared.uss?fileID=7433441132597879392&amp;guid=17eb1a4af7fde4a028f1a0914ab8f993&amp;type=3#FlowShared"/>
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Styles/HubScreen.Base.uss?fileID=7433441132597879392&amp;guid=967327e80cb9b44b29f19b9a867c14d4&amp;type=3#HubScreen.Base"/>
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Styles/HubScreen.Desktop.uss?fileID=7433441132597879392&amp;guid=25e2612828064169a86f6d9780033b64&amp;type=3#HubScreen.Desktop"/>
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Styles/HubScreen.PhoneLandscape.uss?fileID=7433441132597879392&amp;guid=a9f8089b112944bfa66e6d79b8f47fe5&amp;type=3#HubScreen.PhoneLandscape"/>
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Styles/HubScreen.TabletLandscape.uss?fileID=7433441132597879392&amp;guid=e73be94d56e74b11adb8fba0b0ae40a2&amp;type=3#HubScreen.TabletLandscape"/>
    <TheFall.Presentation.UI.AdaptiveUiPreviewRoot preview-profile="PhoneLandscape" style="width: 100%; height: 100%;">
        <Bitbebop.SafeArea collapse-margins="false" exclude-left="false" exclude-top="false" exclude-bottom="false" class="player-safe-area" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0;">
            <ui:VisualElement name="home-stage" class="stage stage-home" style="background-color: rgba(0, 0, 0, 0);">
                <ui:VisualElement name="hub-content" class="hub-content" style="background-color: rgba(36, 26, 20, 0);">
                    <ui:VisualElement class="hub-layout" style="background-color: rgba(36, 26, 20, 0); padding-top: 24px; padding-right: 24px; padding-bottom: 24px; padding-left: 24px;">
                        <ui:VisualElement class="hub-topbar">
                            <ui:VisualElement class="hub-identity panel">
                                <ui:VisualElement class="hub-identity-seal">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-seal-icon icon-shield"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-identity-copy">
                                    <ui:Label name="home-title" class="hub-title">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.profile-name"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:Label name="home-eyebrow" class="hub-kicker">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.eyebrow"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:VisualElement class="hub-xp-row">
                                        <ui:VisualElement class="hub-xp-track">
                                            <ui:VisualElement class="hub-xp-fill"/>
                                        </ui:VisualElement>
                                        <ui:Label name="home-xp-label" class="hub-xp-label">
                                            <Bindings>
                                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.xp-label"/>
                                            </Bindings>
                                        </ui:Label>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label name="home-level-value" class="hub-level-value">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.level-value"/>
                                    </Bindings>
                                </ui:Label>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-stats">
                                <ui:VisualElement class="hub-stat panel hub-stat-brass">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-resource-icon hub-resource-brass icon-coins"/>
                                    <ui:Label name="home-stat-mode-value" class="hub-stat-value">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.stat.mode-value"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-stat panel hub-stat-woad">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-resource-icon hub-resource-woad icon-gems"/>
                                    <ui:Label name="home-stat-target-value" class="hub-stat-value">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.stat.target-value"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-stat panel hub-stat-madder">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-resource-icon hub-resource-madder icon-energy"/>
                                    <ui:Label name="home-stat-deck-value" class="hub-stat-value">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.stat.deck-value"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-top-actions" style="align-self: flex-start;">
                                <ui:Button name="home-mail-button" class="hub-square-button hub-mail-button icon-only-button">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="tooltip" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.mail"/>
                                    </Bindings>
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-square-icon icon-envelope">
                                        <ui:VisualElement picking-mode="Ignore" class="hub-mail-dot"/>
                                    </ui:VisualElement>
                                </ui:Button>
                                <ui:Button name="home-settings-button" class="hub-square-button icon-only-button">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="tooltip" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings"/>
                                    </Bindings>
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-square-icon icon-settings"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="hub-center-space"/>
                        <ui:VisualElement class="hub-bottombar">
                            <ui:VisualElement class="hub-objective panel">
                                <ui:Label name="home-card-label" class="card-label">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.card-label"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-brief-rule"/>
                                <ui:Label name="home-objective-title" class="hub-card-title">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.objective-title"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:Label name="home-subtitle" class="hub-card-copy">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.subtitle"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-objective-progress">
                                    <ui:VisualElement class="hub-progress-fill"/>
                                </ui:VisualElement>
                                <ui:Label name="home-mode" class="hub-objective-meta">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.mode"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:Button name="home-start-button" class="hub-quest-button icon-label-button">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.start"/>
                                    </Bindings>
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon action-button-icon icon-quest"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-dock panel">
                                <ui:VisualElement class="hub-route">
                                    <ui:Button name="home-decks-button" class="hub-nav-button hub-nav-decks">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.nav.decks"/>
                                        </Bindings>
                                        <ui:VisualElement picking-mode="Ignore" class="game-icon hub-nav-icon icon-decks"/>
                                    </ui:Button>
                                    <ui:VisualElement class="hub-route-divider"/>
                                    <ui:Button name="home-bag-button" class="hub-nav-button">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.nav.bag"/>
                                        </Bindings>
                                        <ui:VisualElement picking-mode="Ignore" class="game-icon hub-nav-icon icon-bag"/>
                                    </ui:Button>
                                    <ui:VisualElement class="hub-route-divider"/>
                                    <ui:Button name="home-shop-button" class="hub-nav-button hub-nav-selected">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.nav.shop"/>
                                        </Bindings>
                                        <ui:VisualElement picking-mode="Ignore" class="game-icon hub-nav-icon icon-shop"/>
                                    </ui:Button>
                                    <ui:VisualElement class="hub-route-divider"/>
                                    <ui:Button name="home-rank-button" class="hub-nav-button">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.nav.rank"/>
                                        </Bindings>
                                        <ui:VisualElement picking-mode="Ignore" class="game-icon hub-nav-icon icon-rank"/>
                                    </ui:Button>
                                </ui:VisualElement>
                                <ui:Label name="home-action-status" class="hub-action-status">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.action-status"/>
                                    </Bindings>
                                </ui:Label>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-chat panel">
                                <ui:VisualElement class="hub-chat-tabs">
                                    <ui:Button name="home-chat-global-button" class="hub-chat-tab hub-chat-tab-active">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.chat.global"/>
                                        </Bindings>
                                    </ui:Button>
                                    <ui:Button name="home-chat-guild-button" class="hub-chat-tab">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.chat.guild"/>
                                        </Bindings>
                                    </ui:Button>
                                    <ui:Button name="home-chat-system-button" class="hub-chat-tab">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.chat.system"/>
                                        </Bindings>
                                    </ui:Button>
                                </ui:VisualElement>
                                <ui:VisualElement class="hub-chat-feed">
                                    <ui:Label name="home-chat-date" text="Today" class="hub-chat-date"/>
                                    <ui:Label name="home-chat-message-one" text="Welcome back to The Fall." class="hub-chat-message hub-chat-mobile-primary"/>
                                    <ui:Label name="home-chat-message-two" text="Your next match is ready." class="hub-chat-message hub-chat-mobile-secondary"/>
                                    <ui:Label name="home-chat-message-three" text="Open Settings to adjust the rules." class="hub-chat-message hub-chat-mobile-secondary"/>
                                    <ui:Label name="home-chat-user-message" text="You: Ready." class="hub-chat-message hub-chat-user-message"/>
                                </ui:VisualElement>
                                <ui:Label name="home-chat-input-label" class="hub-chat-input-label">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.chat.input-label"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-chat-input-row">
                                    <ui:TextField name="home-chat-input" class="hub-chat-input"/>
                                    <ui:Button name="home-chat-send-button" class="hub-chat-send icon-only-button">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="tooltip" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.chat.send"/>
                                        </Bindings>
                                        <ui:VisualElement picking-mode="Ignore" class="game-icon hub-send-icon icon-send"/>
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hub-modal" class="hub-modal">
                    <ui:VisualElement class="hub-modal-card panel">
                        <ui:Label name="hub-modal-eyebrow" class="card-label">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.modal.eyebrow"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label name="hub-modal-title" text="Settings" class="section-title"/>
                        <ui:Label name="hub-modal-description" text="Adjust the rules, sound, and motion used for your next quest." class="body-copy"/>
                        <ui:VisualElement name="hub-settings-content" class="hub-settings-content">
                            <ui:VisualElement class="hub-settings-group hub-settings-rules">
                                <ui:VisualElement class="hub-settings-title-row">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-quest"/>
                                    <ui:Label name="home-settings-rules-label" class="hub-settings-heading">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.rules-label"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:Label name="home-settings-rules-copy" class="hub-settings-intro">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.rules-copy"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-settings-grid hub-settings-rules-grid">
                                    <ui:VisualElement class="hub-setting-card">
                                        <ui:Toggle name="home-settings-casas-toggle" value="true" class="rule-toggle hub-setting-toggle">
                                            <Bindings>
                                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.casas"/>
                                            </Bindings>
                                        </ui:Toggle>
                                        <ui:Label name="home-settings-casas-description" class="hub-setting-description">
                                            <Bindings>
                                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.casas-description"/>
                                            </Bindings>
                                        </ui:Label>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="hub-setting-card">
                                        <ui:Toggle name="home-settings-trivilin-toggle" class="rule-toggle hub-setting-toggle">
                                            <Bindings>
                                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.trivilin"/>
                                            </Bindings>
                                        </ui:Toggle>
                                        <ui:Label name="home-settings-trivilin-description" class="hub-setting-description">
                                            <Bindings>
                                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.setup.trivilin-description"/>
                                            </Bindings>
                                        </ui:Label>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-settings-group hub-settings-audio">
                                <ui:VisualElement class="hub-settings-title-row">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-audio"/>
                                    <ui:Label name="home-settings-audio-label" class="hub-settings-heading">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.audio-label"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:Label name="home-settings-audio-copy" class="hub-settings-intro">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.audio-copy"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-settings-compact-grid">
                                    <ui:Toggle name="home-settings-audio-master-toggle" value="true" class="presentation-toggle hub-setting-toggle">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.master"/>
                                        </Bindings>
                                    </ui:Toggle>
                                    <ui:Toggle name="home-settings-audio-effects-toggle" value="true" class="presentation-toggle hub-setting-toggle">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.effects"/>
                                        </Bindings>
                                    </ui:Toggle>
                                    <ui:Toggle name="home-settings-audio-music-toggle" class="presentation-toggle hub-setting-toggle">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.audio.music"/>
                                        </Bindings>
                                    </ui:Toggle>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-settings-group hub-settings-motion">
                                <ui:VisualElement class="hub-settings-title-row">
                                    <ui:VisualElement picking-mode="Ignore" class="game-icon hub-settings-icon icon-skip"/>
                                    <ui:Label name="home-settings-motion-label" class="hub-settings-heading">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.motion-label"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:Label name="home-settings-motion-copy" class="hub-settings-intro">
                                    <Bindings>
                                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.home.settings.motion-copy"/>
                                    </Bindings>
                                </ui:Label>
                                <ui:VisualElement class="hub-settings-compact-grid">
                                    <ui:Toggle name="home-settings-animation-fast-toggle" class="presentation-toggle hub-setting-toggle">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.animation.fast-forward"/>
                                        </Bindings>
                                    </ui:Toggle>
                                    <ui:Toggle name="home-settings-animation-reduced-toggle" class="presentation-toggle hub-setting-toggle">
                                        <Bindings>
                                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.animation.reduced-motion"/>
                                        </Bindings>
                                    </ui:Toggle>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="Game-icons.net · CC BY 3.0 · Lorc, Delapouite &amp; Faithtoken" class="hub-icon-credit"/>
                        </ui:VisualElement>
                        <ui:Button name="hub-modal-close-button" class="secondary-button">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:5366e2894cb2a41e782277c1311dfc07" entry="flow.common.close"/>
                            </Bindings>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </Bitbebop.SafeArea>
    </TheFall.Presentation.UI.AdaptiveUiPreviewRoot>
</ui:UXML>
