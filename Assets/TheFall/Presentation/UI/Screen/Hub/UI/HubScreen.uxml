<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Shared/Styles/FlowShared.uss?fileID=7433441132597879392&amp;guid=17eb1a4af7fde4a028f1a0914ab8f993&amp;type=3#FlowShared"/>
    <Style src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/UI/HubScreen.uss"/>
    <ui:Template name="Profile" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/Profile.uxml"/>
    <ui:Template name="ResourceStats" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/ResourceStats.uxml"/>
    <ui:Template name="TopActions" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/TopActions.uxml"/>
    <ui:Template name="ObjectiveCard" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/ObjectiveCard.uxml"/>
    <ui:Template name="NavigationDock" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/NavigationDock.uxml"/>
    <ui:Template name="ChatPanel" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/ChatPanel.uxml"/>
    <ui:Template name="SettingsModal" src="project://database/Assets/TheFall/Presentation/UI/Screen/Hub/Components/SettingsModal.uxml"/>
    <TheFall.Presentation.UI.AdaptiveUiPreviewRoot preview-profile="Desktop" style="width: 100%; height: 100%;">
        <Bitbebop.SafeArea collapse-margins="false" exclude-left="false" exclude-top="false" exclude-bottom="false" class="player-safe-area" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0;">
            <ui:VisualElement name="home-stage" class="stage stage-home">
                <ui:VisualElement name="hub-content" class="hub-content">
                    <ui:VisualElement class="hub-layout">
                        <ui:VisualElement class="hub-topbar">
                            <ui:Instance template="Profile" class="hub-identity panel"/>
                            <ui:Instance template="ResourceStats" class="hub-stats"/>
                            <ui:Instance template="TopActions" class="hub-top-actions"/>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="hub-center-space"/>
                        <ui:VisualElement class="hub-bottombar">
                            <ui:Instance template="ObjectiveCard" class="hub-objective panel"/>
                            <ui:Instance template="NavigationDock" class="hub-dock panel"/>
                            <ui:Instance template="ChatPanel" class="hub-chat panel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Instance name="hub-modal" template="SettingsModal" class="hub-modal"/>
            </ui:VisualElement>
        </Bitbebop.SafeArea>
    </TheFall.Presentation.UI.AdaptiveUiPreviewRoot>
</ui:UXML>
