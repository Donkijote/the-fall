<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HomeScreen.uss" />
    <ui:VisualElement name="home-screen" class="screen-root">
        <ui:VisualElement class="ambient ambient-left" />
        <ui:VisualElement class="ambient ambient-right" />

        <ui:VisualElement name="login-stage" class="stage stage-login">
            <ui:VisualElement class="login-backdrop" picking-mode="Ignore" />
            <ui:VisualElement class="login-scrim" picking-mode="Ignore" />
            <ui:ScrollView name="login-scroll" class="login-scroll">
                <ui:VisualElement class="login-layout">
                    <ui:VisualElement class="login-hero">
                        <ui:Label name="login-eyebrow" class="eyebrow login-eyebrow" />
                        <ui:Label name="login-title" class="login-display-title" />
                        <ui:Label name="login-title-accent" class="login-display-title login-display-accent" />
                        <ui:VisualElement class="login-story">
                            <ui:VisualElement class="login-story-rule" />
                            <ui:Label name="login-description" class="login-description" />
                        </ui:VisualElement>
                        <ui:VisualElement class="login-proof">
                            <ui:VisualElement class="suit-token suit-token-brass">
                                <ui:Label text="♣" class="suit-token-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="suit-token suit-token-woad">
                                <ui:Label text="♦" class="suit-token-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="suit-token suit-token-madder">
                                <ui:Label text="♠" class="suit-token-label" />
                            </ui:VisualElement>
                            <ui:Label name="login-proof" class="login-proof-copy" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="login-panel panel">
                        <ui:VisualElement class="login-emblem">
                            <ui:Label text="TF" class="login-emblem-label" />
                        </ui:VisualElement>
                        <ui:Label name="login-panel-title" class="login-panel-title" />
                        <ui:Label name="login-panel-subtitle" class="login-panel-subtitle" />
                        <ui:VisualElement class="login-form">
                            <ui:Label name="login-email-label" class="login-field-label" />
                            <ui:VisualElement class="login-input-shell">
                                <ui:Label text="✉" class="login-input-icon" />
                                <ui:TextField name="login-email" class="login-field" />
                            </ui:VisualElement>
                            <ui:VisualElement class="login-password-heading">
                                <ui:Label name="login-password-label" class="login-field-label login-password-label" />
                                <ui:Button name="login-forgot-button" class="login-link-button" />
                            </ui:VisualElement>
                            <ui:VisualElement class="login-input-shell">
                                <ui:Label text="◆" class="login-input-icon" />
                                <ui:TextField name="login-password" class="login-field" is-password-field="true" />
                            </ui:VisualElement>
                            <ui:Button name="login-enter-button" class="primary-button login-enter-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="login-lower-panel">
                            <ui:VisualElement class="login-divider">
                                <ui:VisualElement class="login-divider-rule" />
                                <ui:Label name="login-divider-label" class="login-divider-label" />
                                <ui:VisualElement class="login-divider-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement class="login-social-row">
                                <ui:Button name="login-google-button" class="login-social-button" />
                                <ui:Button name="login-apple-button" class="login-social-button" />
                            </ui:VisualElement>
                            <ui:VisualElement class="login-account-row">
                                <ui:Label name="login-account-prefix" class="login-account-prefix" />
                                <ui:Button name="login-create-button" class="login-link-button login-create-button" />
                            </ui:VisualElement>
                            <ui:Label name="login-feedback" class="login-feedback" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="home-stage" class="stage stage-home">
            <ui:ScrollView name="hub-scroll" class="hub-scroll">
                <ui:VisualElement class="hub-layout">
                    <ui:VisualElement class="hub-topbar">
                        <ui:VisualElement class="hub-identity panel">
                            <ui:VisualElement class="hub-identity-seal">
                                <ui:Label text="TF" class="hub-seal-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-identity-copy">
                                <ui:Label name="home-title" class="hub-title" />
                                <ui:Label name="home-eyebrow" class="hub-kicker" />
                                <ui:VisualElement class="hub-xp-row">
                                    <ui:VisualElement class="hub-xp-track">
                                        <ui:VisualElement class="hub-xp-fill" />
                                    </ui:VisualElement>
                                    <ui:Label name="home-xp-label" class="hub-xp-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="home-level-value" class="hub-level-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="hub-stats">
                            <ui:VisualElement class="hub-stat panel hub-stat-brass">
                                <ui:Label text="●" class="hub-resource-icon hub-resource-brass" />
                                <ui:Label name="home-stat-mode-label" class="hub-stat-label" />
                                <ui:Label name="home-stat-mode-value" class="hub-stat-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-stat panel hub-stat-woad">
                                <ui:Label text="◆" class="hub-resource-icon hub-resource-woad" />
                                <ui:Label name="home-stat-target-label" class="hub-stat-label" />
                                <ui:Label name="home-stat-target-value" class="hub-stat-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-stat panel hub-stat-madder">
                                <ui:Label text="ϟ" class="hub-resource-icon hub-resource-madder" />
                                <ui:Label name="home-stat-deck-label" class="hub-stat-label" />
                                <ui:Label name="home-stat-deck-value" class="hub-stat-value" />
                                <ui:VisualElement class="hub-energy-track">
                                    <ui:VisualElement class="hub-energy-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="hub-top-actions">
                            <ui:Button name="home-mail-button" class="hub-square-button hub-mail-button" />
                            <ui:VisualElement class="hub-mail-dot" />
                            <ui:Button name="home-settings-button" class="hub-square-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="hub-center-space" picking-mode="Ignore" />

                    <ui:VisualElement class="hub-bottombar">
                        <ui:VisualElement class="hub-objective panel">
                            <ui:Label name="home-card-label" class="card-label" />
                            <ui:VisualElement class="hub-brief-rule" />
                            <ui:Label name="home-objective-title" class="hub-card-title" />
                            <ui:Label name="home-subtitle" class="hub-card-copy" />
                            <ui:VisualElement class="hub-objective-progress">
                                <ui:VisualElement class="hub-progress-fill" />
                            </ui:VisualElement>
                            <ui:Label name="home-mode" class="hub-objective-meta" />
                            <ui:Button name="home-start-button" class="hub-quest-button" />
                        </ui:VisualElement>

                        <ui:VisualElement class="hub-dock panel">
                            <ui:VisualElement class="hub-route">
                                <ui:Button name="home-decks-button" class="hub-nav-button hub-nav-decks" />
                                <ui:VisualElement class="hub-route-divider" />
                                <ui:Button name="home-bag-button" class="hub-nav-button" />
                                <ui:VisualElement class="hub-route-divider" />
                                <ui:Button name="home-shop-button" class="hub-nav-button hub-nav-selected" />
                                <ui:VisualElement class="hub-route-divider" />
                                <ui:Button name="home-rank-button" class="hub-nav-button" />
                            </ui:VisualElement>
                            <ui:Label name="home-action-status" class="hub-action-status" />
                        </ui:VisualElement>

                        <ui:VisualElement class="hub-chat panel">
                            <ui:VisualElement class="hub-chat-tabs">
                                <ui:Button name="home-chat-global-button" class="hub-chat-tab hub-chat-tab-active" />
                                <ui:Button name="home-chat-guild-button" class="hub-chat-tab" />
                                <ui:Button name="home-chat-system-button" class="hub-chat-tab" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hub-chat-feed">
                                <ui:Label name="home-chat-date" class="hub-chat-date" />
                                <ui:Label name="home-chat-message-one" class="hub-chat-message" />
                                <ui:Label name="home-chat-message-two" class="hub-chat-message" />
                                <ui:Label name="home-chat-message-three" class="hub-chat-message" />
                                <ui:Label name="home-chat-user-message" class="hub-chat-message hub-chat-user-message" />
                            </ui:VisualElement>
                            <ui:Label name="home-chat-input-label" class="hub-chat-input-label" />
                            <ui:VisualElement class="hub-chat-input-row">
                                <ui:TextField name="home-chat-input" class="hub-chat-input" />
                                <ui:Button name="home-chat-send-button" class="hub-chat-send" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="hub-modal" class="hub-modal">
                <ui:VisualElement class="hub-modal-card panel">
                    <ui:Label name="hub-modal-eyebrow" class="card-label" />
                    <ui:Label name="hub-modal-title" class="section-title" />
                    <ui:Label name="hub-modal-description" class="body-copy" />
                    <ui:Button name="hub-modal-close-button" class="secondary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="setup-stage" class="stage stage-setup">
            <ui:VisualElement class="panel setup-panel">
                <ui:ScrollView name="setup-scroll" class="setup-scroll">
                    <ui:Label name="setup-eyebrow" class="eyebrow" />
                    <ui:Label name="setup-title" class="section-title" />
                    <ui:Label name="setup-subtitle" class="body-copy" />
                    <ui:Label name="setup-default-note" class="default-note" />

                    <ui:VisualElement class="setup-options">
                        <ui:VisualElement class="option-card">
                            <ui:Label name="casas-default" class="default-badge" />
                            <ui:Toggle name="casas-toggle" class="rule-toggle" />
                            <ui:Label name="casas-description" class="option-description" />
                            <ui:Label name="casas-state" class="option-state" />
                        </ui:VisualElement>
                        <ui:VisualElement class="option-card">
                            <ui:Label name="trivilin-default" class="default-badge" />
                            <ui:Toggle name="trivilin-toggle" class="rule-toggle" />
                            <ui:Label name="trivilin-description" class="option-description" />
                            <ui:Label name="trivilin-state" class="option-state" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="fixed-card">
                        <ui:Label name="setup-fixed-label" class="card-label" />
                        <ui:Label name="setup-fixed" class="fixed-summary" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement class="setup-footer">
                    <ui:VisualElement class="button-row">
                        <ui:Button name="setup-back-button" class="secondary-button" />
                        <ui:Button name="setup-start-button" class="primary-button" />
                    </ui:VisualElement>
                    <ui:Label name="setup-prompt" class="input-prompt" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loading-stage" class="stage stage-loading">
            <ui:VisualElement class="panel loading-panel">
                <ui:Label name="loading-eyebrow" class="eyebrow" />
                <ui:VisualElement class="loading-glyph" />
                <ui:Label name="loading-title" class="section-title centered" />
                <ui:Label name="loading-message" class="body-copy centered" />
                <ui:Label name="loading-session" class="loading-session" />
                <ui:Label name="loading-status" class="loading-status" />
                <ui:Button name="loading-home-button" class="quiet-button loading-cancel" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="match-stage" class="stage stage-match">
            <ui:VisualElement class="match-shell">
                <ui:VisualElement class="match-header panel">
                    <ui:VisualElement class="match-heading">
                        <ui:Label name="match-eyebrow" class="eyebrow" />
                        <ui:Label name="match-title" class="section-title compact-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="match-header-actions">
                        <ui:Toggle name="audio-master-toggle" value="true" class="presentation-toggle audio-toggle" />
                        <ui:Toggle name="audio-effects-toggle" value="true" class="presentation-toggle audio-toggle" />
                        <ui:Toggle name="audio-music-toggle" class="presentation-toggle audio-toggle" />
                        <ui:Toggle name="animation-fast-toggle" class="presentation-toggle" />
                        <ui:Toggle name="animation-reduced-toggle" class="presentation-toggle" />
                        <ui:Button name="animation-skip-button" class="quiet-button presentation-skip" />
                        <ui:Button name="match-home-button" class="quiet-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="match-grid">
                    <ui:VisualElement class="match-status panel">
                        <ui:Label name="match-phase" class="status-title" />
                        <ui:Label name="match-score" class="score-line" />
                        <ui:Label name="match-progress" class="status-line" />
                        <ui:Label name="match-turn" class="status-line" />
                        <ui:Label name="match-canto" class="status-line canto-line" />
                        <ui:Label name="match-event" class="status-line event-line" />
                    </ui:VisualElement>
                    <ui:VisualElement name="match-table-space" class="match-table-space" picking-mode="Ignore">
                        <ui:VisualElement name="match-context-controls" class="match-context-controls" picking-mode="Ignore">
                            <ui:VisualElement name="dealer-context" class="player-context player-context-dealer">
                                <ui:VisualElement name="dealer-options-menu" class="context-menu panel">
                                    <ui:Label name="dealer-options-title" class="context-title" />
                                    <ui:VisualElement name="dealer-options" class="context-options" />
                                </ui:VisualElement>
                                <ui:Button name="dealer-options-button" class="context-icon dealer-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement name="canto-context" class="player-context player-context-canto">
                                <ui:VisualElement name="canto-options-menu" class="context-menu panel">
                                    <ui:Label name="canto-options-title" class="context-title" />
                                    <ui:VisualElement name="canto-options" class="context-options" />
                                </ui:VisualElement>
                                <ui:Button name="canto-options-button" class="context-icon canto-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="interaction-strip panel" picking-mode="Ignore">
                            <ui:Label name="match-feedback" class="interaction-feedback" />
                            <ui:Label name="match-prompt" class="input-prompt match-input-prompt" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="result-stage" class="stage stage-result">
            <ui:VisualElement class="panel result-panel">
                <ui:Label name="result-eyebrow" class="eyebrow" />
                <ui:Label name="result-title" class="section-title centered" />
                <ui:VisualElement class="result-seal">
                    <ui:Label name="result-winner-label" class="card-label result-winner-label" />
                    <ui:Label name="result-outcome" class="result-outcome" />
                </ui:VisualElement>
                <ui:Label name="result-score" class="result-score" />
                <ui:Label name="result-rules" class="result-rules" />
                <ui:Label name="result-next" class="result-next" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="result-home-button" class="secondary-button" />
                    <ui:Button name="result-replay-button" class="primary-button" />
                </ui:VisualElement>
                <ui:Label name="result-prompt" class="input-prompt" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
