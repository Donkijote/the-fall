.match-shell {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: none;
}

.presentation-skip {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    margin-top: 18px;
}

.match-status {
    position: absolute;
    left: 0;
    top: 50%;
    width: 310px;
    min-width: 310px;
    max-height: 600px;
    margin-top: -270px;
    padding: 18px;
    background-color: rgba(36, 26, 20, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(181, 139, 62);
}

.match-status-content,
.match-status-summary,
.match-status-resolution {
    min-width: 0;
}

.match-status-heading {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.match-table-space {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
}

.match-score-hud {
    position: absolute;
    left: 50%;
    top: 0;
    width: 430px;
    min-width: 430px;
    margin-left: -215px;
    padding: 9px 20px;
    background-color: rgba(36, 26, 20, 0.92);
    border-bottom-width: 3px;
    border-bottom-color: rgb(181, 139, 62);
}

.status-title {
    min-width: 0;
    flex-grow: 1;
    color: rgb(181, 139, 62);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.match-progress {
    min-width: 0;
    flex-grow: 1;
    margin-left: 12px;
    color: rgb(197, 178, 142);
    font-size: 13px;
    -unity-text-align: middle-right;
    white-space: normal;
}

.match-status-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 14px;
    background-color: rgba(216, 196, 147, 0.24);
}

.match-primary-status {
    color: rgb(245, 226, 176);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.score-line {
    color: rgb(245, 226, 176);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.match-score-objective {
    margin-top: 2px;
    color: rgb(181, 139, 62);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
}

.status-line {
    color: rgb(197, 178, 142);
    font-size: 16px;
    white-space: normal;
}

.interaction-feedback {
    min-height: 0;
    margin-top: 4px;
    color: rgb(174, 162, 139);
    font-size: 13px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.match-canto-row {
    min-height: 36px;
    margin-top: 12px;
    padding: 8px 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(70, 92, 115, 0.20);
    border-left-width: 2px;
    border-left-color: rgb(70, 92, 115);
    border-radius: 7px;
}

.match-canto-icon {
    width: 20px;
    min-width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(181, 139, 62);
}

.match-canto {
    min-width: 0;
    flex-grow: 1;
    color: rgb(216, 196, 147);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.match-callout {
    margin-top: 10px;
    padding: 10px 12px;
    background-color: rgba(15, 12, 10, 0.52);
    border-left-width: 3px;
    border-left-color: rgb(112, 136, 155);
    border-radius: 7px;
}

.match-callout-label {
    color: rgb(181, 139, 62);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.match-feedback-callout {
    min-height: 54px;
    flex-direction: row;
    align-items: center;
}

.match-feedback-symbol {
    width: 30px;
    min-width: 30px;
    margin-right: 8px;
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.match-feedback-copy {
    flex-grow: 1;
    min-width: 0;
}

.match-context-controls {
    position: absolute;
    left: 50%;
    bottom: 13%;
    margin-left: 86px;
    flex-direction: row;
    align-items: flex-end;
}

.player-context {
    display: none;
    width: 64px;
    margin-left: 10px;
    align-items: center;
}

.context-icon {
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    padding-left: 0;
    padding-right: 0;
    border-radius: 29px;
    color: rgb(36, 26, 20);
    background-color: rgb(216, 196, 147);
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(181, 139, 62);
    font-size: 17px;
    -unity-font-style: bold;
}

.dealer-icon {
    background-color: rgb(181, 139, 62);
}

.canto-icon {
    color: rgb(245, 226, 176);
    background-color: rgb(70, 92, 115);
}

.context-menu {
    display: none;
    position: absolute;
    width: 410px;
    max-height: 330px;
    left: 0;
    bottom: 68px;
    padding: 16px;
}

.context-title {
    margin-bottom: 10px;
    color: rgb(245, 226, 176);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.context-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.context-action-button {
    width: 48%;
    min-height: 46px;
    margin-right: 2%;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(236, 215, 169);
    background-color: rgb(70, 92, 115);
    border-left-color: rgb(112, 136, 155);
    border-right-color: rgb(50, 68, 82);
    border-top-color: rgb(112, 136, 155);
    border-bottom-color: rgb(50, 68, 82);
    font-size: 14px;
}

.screen-root.profile-mobile-portrait .match-score-hud {
    width: 46%;
    min-width: 0;
    margin-left: -23%;
    padding: 28px 34px;
    border-bottom-width: 8px;
}

.screen-root.profile-mobile-portrait .match-status {
    left: 0;
    top: auto;
    bottom: 0;
    width: 100%;
    min-width: 0;
    max-height: 1080px;
    margin-top: 0;
    padding: 48px;
    border-left-width: 10px;
}

.screen-root.profile-mobile-portrait .match-status-heading {
    flex-direction: column;
    align-items: flex-start;
}

.screen-root.profile-mobile-portrait .match-status-content {
    flex-direction: row;
    align-items: stretch;
}

.screen-root.profile-mobile-portrait .match-status-summary {
    width: 48%;
    min-width: 0;
    margin-right: 24px;
}

.screen-root.profile-mobile-portrait .match-status-resolution {
    flex-grow: 1;
    min-width: 0;
}

.screen-root.profile-mobile-portrait .match-progress {
    margin-top: 12px;
    margin-left: 0;
    -unity-text-align: middle-left;
}

.screen-root.profile-mobile-portrait .status-title {
    display: none;
}

.screen-root.profile-mobile-portrait .match-progress,
.screen-root.profile-mobile-portrait .match-score-objective,
.screen-root.profile-mobile-portrait .match-callout-label {
    font-size: 67px;
}

.screen-root.profile-mobile-portrait .score-line {
    font-size: 76px;
}

.screen-root.profile-mobile-portrait .match-primary-status {
    font-size: 76px;
}

.screen-root.profile-mobile-portrait .status-line,
.screen-root.profile-mobile-portrait .interaction-feedback,
.screen-root.profile-mobile-portrait .match-canto {
    font-size: 67px;
}

.screen-root.profile-mobile-portrait .match-canto-row {
    min-height: 146px;
    margin-top: 26px;
    padding: 22px 26px;
    border-left-width: 8px;
}

.screen-root.profile-mobile-portrait .match-canto-icon {
    width: 62px;
    min-width: 62px;
    height: 62px;
    margin-right: 24px;
}

.screen-root.profile-mobile-portrait .match-callout {
    margin-top: 24px;
    padding: 26px 30px;
    border-left-width: 9px;
}

.screen-root.profile-mobile-portrait .match-feedback-callout {
    min-height: 190px;
}

.screen-root.profile-mobile-portrait .match-feedback-symbol {
    width: 82px;
    min-width: 82px;
    margin-right: 22px;
    font-size: 64px;
}

.screen-root.profile-mobile-portrait .presentation-skip {
    min-height: 210px;
    margin-top: 34px;
    font-size: 64px;
}

.screen-root.profile-mobile-portrait .match-context-controls {
    bottom: 30%;
    margin-left: 110px;
}

.screen-root.profile-mobile-portrait .player-context {
    width: 230px;
    margin-left: 32px;
}

.screen-root.profile-mobile-portrait .context-icon {
    width: 210px;
    min-width: 210px;
    height: 210px;
    min-height: 210px;
    border-radius: 105px;
    font-size: 58px;
}

.screen-root.profile-mobile-portrait .context-menu {
    width: 1120px;
    max-height: 1080px;
    left: auto;
    right: 0;
    bottom: 238px;
    padding: 52px;
}

.screen-root.profile-mobile-portrait .context-title {
    margin-bottom: 32px;
    font-size: 67px;
}

.screen-root.profile-mobile-portrait .context-action-button {
    min-height: 210px;
    margin-bottom: 24px;
    font-size: 67px;
}

.screen-root.profile-mobile-landscape .match-score-hud {
    width: 520px;
    min-width: 520px;
    margin-left: -260px;
    padding: 16px 28px;
    border-bottom-width: 5px;
}

.screen-root.profile-mobile-landscape .match-status {
    left: 0;
    top: 50%;
    width: 520px;
    min-width: 520px;
    max-height: 790px;
    margin-top: -370px;
    padding: 26px;
    border-left-width: 6px;
}

.screen-root.profile-mobile-landscape .status-title {
    display: none;
}

.screen-root.profile-mobile-landscape .match-progress,
.screen-root.profile-mobile-landscape .match-score-objective,
.screen-root.profile-mobile-landscape .match-callout-label {
    font-size: 31px;
}

.screen-root.profile-mobile-landscape .score-line {
    font-size: 40px;
}

.screen-root.profile-mobile-landscape .match-primary-status {
    font-size: 38px;
}

.screen-root.profile-mobile-landscape .status-line,
.screen-root.profile-mobile-landscape .interaction-feedback,
.screen-root.profile-mobile-landscape .context-title,
.screen-root.profile-mobile-landscape .match-canto {
    font-size: 31px;
}

.screen-root.profile-mobile-landscape .match-canto-row {
    min-height: 82px;
    margin-top: 14px;
    padding: 12px 14px;
    border-left-width: 5px;
}

.screen-root.profile-mobile-landscape .match-canto-icon {
    width: 34px;
    min-width: 34px;
    height: 34px;
    margin-right: 12px;
}

.screen-root.profile-mobile-landscape .match-callout {
    margin-top: 12px;
    padding: 14px 16px;
    border-left-width: 5px;
}

.screen-root.profile-mobile-landscape .match-feedback-callout {
    min-height: 102px;
}

.screen-root.profile-mobile-landscape .match-feedback-symbol {
    width: 46px;
    min-width: 46px;
    margin-right: 12px;
    font-size: 38px;
}

.screen-root.profile-mobile-landscape .presentation-skip {
    min-height: 100px;
    margin-top: 22px;
    font-size: 35px;
}

.screen-root.profile-mobile-landscape .context-icon {
    width: 96px;
    min-width: 96px;
    height: 96px;
    min-height: 96px;
    border-radius: 48px;
    font-size: 28px;
}

.screen-root.profile-mobile-landscape .context-menu {
    width: 620px;
    max-height: 520px;
    bottom: 112px;
    padding: 24px;
}

.screen-root.profile-mobile-landscape .context-action-button {
    min-height: 96px;
    font-size: 31px;
}

.context-button-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 30px;
    margin-left: -15px;
    margin-top: -15px;
    -unity-background-image-tint-color: rgb(36, 26, 20);
}

.canto-icon .context-button-icon {
    -unity-background-image-tint-color: rgb(245, 226, 176);
}
