.match-status {
    position: absolute;
    left: 0;
    top: 50%;
    width: 310px;
    min-width: 310px;
    max-height: 600px;
    margin-top: -270px;
    padding: 18px;
    background-color: rgba(36, 26, 20, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(181, 139, 62);
}

.match-status-content,
.match-status-summary,
.match-status-resolution {
    min-width: 0;
}

.match-status-heading {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.status-title {
    min-width: 0;
    flex-grow: 1;
    color: rgb(181, 139, 62);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
}

.match-progress {
    min-width: 0;
    flex-grow: 1;
    margin-left: 12px;
    color: rgb(197, 178, 142);
    font-size: 13px;
    -unity-text-align: middle-right;
    white-space: normal;
}

.match-status-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 14px;
    background-color: rgba(216, 196, 147, 0.24);
}

.match-primary-status {
    color: rgb(245, 226, 176);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.match-canto-row {
    min-height: 36px;
    margin-top: 12px;
    padding: 8px 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(70, 92, 115, 0.20);
    border-left-width: 2px;
    border-left-color: rgb(70, 92, 115);
    border-radius: 7px;
}

.match-canto-icon {
    width: 20px;
    min-width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(181, 139, 62);
}

.match-canto {
    min-width: 0;
    flex-grow: 1;
    color: rgb(216, 196, 147);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.match-callout {
    margin-top: 10px;
    padding: 10px 12px;
    background-color: rgba(15, 12, 10, 0.52);
    border-left-width: 3px;
    border-left-color: rgb(112, 136, 155);
    border-radius: 7px;
}

.match-callout-label {
    color: rgb(181, 139, 62);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.status-line {
    color: rgb(197, 178, 142);
    font-size: 16px;
    white-space: normal;
}

.event-line {
    margin-top: 4px;
    color: rgb(216, 196, 147);
    -unity-font-style: bold;
}

.match-feedback-callout {
    min-height: 54px;
    flex-direction: row;
    align-items: center;
}

.match-feedback-symbol {
    width: 30px;
    min-width: 30px;
    margin-right: 8px;
    color: rgb(245, 226, 176);
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.match-feedback-copy {
    flex-grow: 1;
    min-width: 0;
}

.interaction-feedback {
    min-height: 0;
    margin-top: 4px;
    color: rgb(174, 162, 139);
    font-size: 13px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.presentation-skip {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    margin-top: 18px;
}

.outcome-capture {
    border-left-color: rgb(70, 92, 115);
}

.outcome-fall {
    border-left-width: 5px;
    border-left-color: rgb(181, 139, 62);
    background-color: rgba(181, 139, 62, 0.14);
}

.outcome-clean-table {
    border-left-width: 5px;
    border-left-color: rgb(107, 140, 70);
    background-color: rgba(107, 140, 70, 0.14);
}

.outcome-canto {
    border-left-color: rgb(112, 136, 155);
    background-color: rgba(70, 92, 115, 0.15);
}

.outcome-score {
    border-left-color: rgb(181, 139, 62);
}

.outcome-tie {
    border-left-width: 5px;
    border-left-color: rgb(160, 144, 118);
    background-color: rgba(160, 144, 118, 0.14);
}

.outcome-victory {
    border-left-width: 5px;
    border-left-color: rgb(181, 139, 62);
    background-color: rgba(181, 139, 62, 0.22);
}
