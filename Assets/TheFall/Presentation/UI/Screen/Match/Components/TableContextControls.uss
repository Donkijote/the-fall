.match-context-controls {
    position: absolute;
    left: 50%;
    bottom: 13%;
    margin-left: 86px;
    flex-direction: row;
    align-items: flex-end;
}

.player-context {
    display: none;
    width: 64px;
    margin-left: 10px;
    align-items: center;
}

.context-icon {
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    padding-left: 0;
    padding-right: 0;
    border-radius: 29px;
    color: rgb(36, 26, 20);
    background-color: rgb(216, 196, 147);
    border-left-color: rgb(245, 226, 176);
    border-right-color: rgb(181, 139, 62);
    border-top-color: rgb(245, 226, 176);
    border-bottom-color: rgb(181, 139, 62);
}

.dealer-icon {
    background-color: rgb(181, 139, 62);
}

.canto-icon {
    color: rgb(245, 226, 176);
    background-color: rgb(70, 92, 115);
}

.context-button-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 30px;
    margin-left: -15px;
    margin-top: -15px;
    -unity-background-image-tint-color: rgb(36, 26, 20);
}

.canto-icon .context-button-icon {
    -unity-background-image-tint-color: rgb(245, 226, 176);
}

.context-menu {
    display: none;
    position: absolute;
    left: 0;
    bottom: 68px;
    width: 410px;
    max-height: 330px;
    padding: 16px;
}

.context-title {
    margin-bottom: 10px;
    color: rgb(245, 226, 176);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.context-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.context-action-button {
    width: 48%;
    min-height: 46px;
    margin-right: 2%;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(236, 215, 169);
    background-color: rgb(70, 92, 115);
    border-left-color: rgb(112, 136, 155);
    border-right-color: rgb(50, 68, 82);
    border-top-color: rgb(112, 136, 155);
    border-bottom-color: rgb(50, 68, 82);
    font-size: 14px;
}
